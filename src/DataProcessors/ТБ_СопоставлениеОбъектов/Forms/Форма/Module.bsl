Процедура ЗагрузитьИзВнешнегоИсточника(Команда)
	
	ЗагрузитьИзВнешнегоИсточникаНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВXML(Команда)
	
	Если ТаблицаИсточникаДанных.Количество() = 0 Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Нет данных для выгрузки.'"));
		Возврат;
		
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьВXMLЗавершение", ЭтотОбъект);
	
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогОткрытияФайла.Фильтр = НСтр("ru = 'Файлы XML (*.xml)|*.xml'");
	ДиалогОткрытияФайла.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзXML(Команда)
	
	Если ТаблицаИсточникаДанных.Количество() <> 0 Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьВXMLВопрос", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Очистить таблицу данных источника перед загрузкой?'");
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
		Возврат;
		
	КонецЕсли;
	
	ЗагрузитьИзXMLНаКлиенте();
	
КонецПроцедуры

