
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	УстановитьДоступностьПоТипуИсточника();
	
	Объект.ТипПравила = Перечисления.ТБ_ТипыПравилСопоставления.СопоставлениеОбъектов;
	УстановитьДоступностьПоТипуПравила();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	ЗначениеНастройки = Настройки.Получить("Объект.ИсточникДанных");
	Если ЗначениеНастройки <> Неопределено Тогда
		
		Объект.ИсточникДанных = ЗначениеНастройки;
		ИсточникДанныхПриИзмененииНаСервере();
		
		Настройки.Удалить("Объект.ИсточникДанных");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_СоответствияОбъектов"
		Или ИмяСобытия = "Удаление_СоответствияОбъектов" Тогда
		ЗаполнитьСлужебныеРеквизиты();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаСоответствияОбъектов
		И ДанныеИсточникаИзменены Тогда
		ЗаполнитьСоответствияОбъектов(Объект.ПравилоСопоставления, Объект.ИсточникДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникДанныхПриИзменении(Элемент)
	
	Если Объект.ИсточникДанных <> ТекущийИсточникДанных
		И ТаблицаИсточникаДанных.Количество() <> 0 Тогда
		
		Оповещение = Новый ОписаниеОповещения("ИсточникДанныхПриИзмененииЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'При изменении источника таблица данных будет очищена. Продолжить?'");
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	ИсточникДанныхПриИзмененииНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура ТипПравилаПриИзменении(Элемент)
	
	ТипПравилаПриИзмененииНаСервере();
	
КонецПроцедуры

