&НаКлиенте
Процедура ПоказатьДублиПоПолямПоиска(Команда)
	
	ПоказатьДублиПоПолямПоиска = Не ПоказатьДублиПоПолямПоиска;
	Элементы.ПоказатьДублиПоПолямПоиска.Пометка = ПоказатьДублиПоПолямПоиска;
	
	ОбновитьОтборСтрокТаблицыСопоставления();
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставитьОбъекты(Команда)
	
	ОчиститьСообщения();
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = СоответствияОбъектов.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если НайденныеСтроки.Количество() = 0 Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны строки для сопоставления.'"));
		Возврат;
		
	КонецЕсли;
	
	Для каждого СтрокаСоответствия Из НайденныеСтроки Цикл
		
		СтрокаСоответствия.Объект       = Неопределено;
		СтрокаСоответствия.Сопоставлено = Ложь;
		
	КонецЦикла;
	
	Если Объект.ТипПравила = ПредопределенноеЗначение("Перечисление.ТБ_ТипыПравилСопоставления.СопоставлениеОбъектов") Тогда
		КоличествоЗаписей = СопоставитьОбъектыНаСервере();
	Иначе
		КоличествоЗаписей = СопоставитьОбъектыДляЗагрузкиТЧНаСервере();
	КонецЕсли;
	
	//ОповеститьОбИзменении(ТипЗнч()); // доделать
	
	ОбновитьОтборСтрокТаблицыСопоставления();
	
	ПоказатьОповещениеПользователя(СтрШаблон(НСтр("ru = 'Сопоставление завершено (%1)'"), КоличествоЗаписей),
		,
		НСтр("ru = 'Сопоставление объектов завершено.'"),
		БиблиотекаКартинок.Информация32);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТолькоНесопоставленные(Команда)
	
	ПоказатьТолькоНесопоставленные = Не ПоказатьТолькоНесопоставленные;
	Элементы.ПоказатьТолькоНесопоставленные.Пометка = ПоказатьТолькоНесопоставленные;
	
	ОбновитьОтборСтрокТаблицыСопоставления();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСопоставленныеОбъекты(Команда)
	
	Отказ = Ложь;
	КоличествоЗаписей = СохранитьСопоставленныеОбъектыНаСервере(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если КоличествоЗаписей = 0 Тогда
		
		ПоказатьОповещениеПользователя(НСтр("ru = 'Соответствие не сохранено'"),
			,
			НСтр("ru = 'Нет сопоставленных объектов.'"),
			БиблиотекаКартинок.Информация32);
		
	Иначе
		
		ПоказатьОповещениеПользователя(СтрШаблон(НСтр("ru = 'Соответствие сохранено (%1)'"), КоличествоЗаписей),
			,
			НСтр("ru = 'Соответствие сопоставленных объектов записано.'"),
			БиблиотекаКартинок.Информация32);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьТабличнуюЧасть(Команда)
	
	ОчиститьСообщения();
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = СоответствияОбъектов.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если НайденныеСтроки.Количество() = 0 Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны строки для сопоставления.'"));
		Возврат;
		
	КонецЕсли;
	
	Для каждого СтрокаСоответствия Из НайденныеСтроки Цикл
		
		СтрокаСоответствия.Объект       = Неопределено;
		СтрокаСоответствия.Сопоставлено = Ложь;
		
	КонецЦикла;
	
	КоличествоЗаписей = СопоставитьОбъектыДляЗагрузкиТЧНаСервере(Истина);
	
	ОбновитьОтборСтрокТаблицыСопоставления();
	
	ПоказатьОповещениеПользователя(СтрШаблон(НСтр("ru = 'Загрузка завершена (%1)'"), КоличествоЗаписей),
		,
		НСтр("ru = 'Загрузка табличной части завершена.'"),
		БиблиотекаКартинок.Информация32);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСопоставление(Команда)
	
	ТекущиеДанные = Элементы.СоответствияОбъектов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЕстьЗапись Тогда
		
		ПараметрыФормы = Новый Структура("Ключ", КлючЗаписиСоответствия(ТекущиеДанные.Идентификатор, ТекущиеДанные.ИмяОбъекта));
		
		ОткрытьФорму("РегистрСведений.ТБ_СоответствияОбъектов.Форма.ФормаЗаписи", ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

