#Область ПрограммныйИнтерфейс

// Записывает соответствие объекта источника в регистр сведений.
//
// Параметры:
//  СтрокаСоответствия - Структура - данные соответствия объекта.
//
Процедура ЗаписатьСоответствие(Знач СтрокаСоответствия) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Идентификатор.Установить(СтрокаСоответствия.Идентификатор);
	НаборЗаписей.Отбор.ИмяОбъекта.Установить(СтрокаСоответствия.ИмяОбъекта);
	
	ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СтрокаСоответствия);
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Находит объект по идентификатору соответствия и типу значения.
//
// Параметры:
//  Идентификатор - Строка - идентификатор объекта в источнике.
//  ТипЗначения - Тип - тип искомого объекта.
//
// Возвращаемое значение:
//  Произвольный - найденный объект или пустая ссылка указанного типа.
//
Функция НайтиОбъектПоСоответствию(Знач Идентификатор, Знач ТипЗначения) Экспорт
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
	
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	СоответствияОбъектов.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.ТБ_СоответствияОбъектов КАК СоответствияОбъектов
		|ГДЕ
		|	СоответствияОбъектов.Идентификатор = &Идентификатор
		|	И СоответствияОбъектов.ИмяОбъекта = &ИмяОбъекта");
		
		Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
		Запрос.УстановитьПараметр("ИмяОбъекта",    Метаданные.НайтиПоТипу(ТипЗначения).ПолноеИмя());
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Объект;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый(ТипЗначения);
	
КонецФункции

// Возвращает полное имя объекта метаданных по ссылке на объект.
//
// Параметры:
//  Объект - Произвольный - ссылка на объект информационной базы.
//
// Возвращаемое значение:
//  Строка - полное имя объекта метаданных или пустая строка.
//
Функция ИмяОбъекта(Знач Объект) Экспорт
	
	Если ЗначениеЗаполнено(Объект) Тогда
		Возврат Объект.Метаданные().ПолноеИмя();
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#КонецЕсли
