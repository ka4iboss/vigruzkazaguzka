
#Область ПрограммныйИнтерфейс

// Возвращает представление значения из списка выбора.
//
// Параметры:
//  Значение - Произвольный - значение, для которого требуется представление.
//  СписокВыбора - СписокЗначений из Произвольный - список выбора.
//
// Возвращаемое значение:
//  Строка, Произвольный - представление значения или исходное значение, если оно не найдено.
//
Функция ПредставлениеЗначения(Знач Значение, Знач СписокВыбора) Экспорт
	
	Элемент = СписокВыбора.НайтиПоЗначению(Значение);
	Если Элемент <> Неопределено Тогда
		Возврат Элемент.Представление;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#Область ТаблицаИсточника

// Возвращает структуру значений свойств источника по строке данных.
//
// Параметры:
//  СтрокаИсточника - СтрокаТаблицыЗначений, СтрокаДереваЗначений, Структура - строка данных источника.
//  СвойстваИсточника - ТаблицаЗначений - свойства источника данных.
//
// Возвращаемое значение:
//  Структура - значения свойств источника.
//
Функция СтруктураДанныхИсточника(СтрокаИсточника, Знач СвойстваИсточника) Экспорт
	
	Результат = Новый Структура;
	
	Для каждого Свойство Из СвойстваИсточника Цикл
		Результат.Вставить(Свойство.Имя, СтрокаИсточника[Свойство.Имя]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОбщегоНазначения

// Устанавливает пометки строк таблицы формы.
//
// Параметры:
//  Таблица - ТаблицаФормы - таблица формы, в которой устанавливаются пометки.
//  Элемент - ТаблицаФормы - элемент формы, связанный с таблицей.
//  Пометка - Булево - устанавливаемое значение пометки.
//  ПараметрыОтбора - Структура, Неопределено - отбор строк.
//  Модифицированность - Булево - признак изменения данных формы.
//
Процедура УстановитьПометки(Таблица, Элемент, Знач Пометка, ПараметрыОтбора = Неопределено, Модифицированность = Ложь) Экспорт
	
	Если Элемент.ВыделенныеСтроки.Количество() > 1 Тогда
		
		Для каждого ИдентификаторСтроки Из Элемент.ВыделенныеСтроки Цикл
			
			СтрокаТаблицы = Таблица.НайтиПоИдентификатору(ИдентификаторСтроки);
			Если СоответствуетОтбору(СтрокаТаблицы, ПараметрыОтбора) Тогда
				
				СтрокаТаблицы.Пометка = Пометка;
				Модифицированность = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура("Пометка", Не Пометка));
		Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
			
			ИдентификаторСтроки = СтрокаТаблицы.ПолучитьИдентификатор();
			
			Если Элемент.ПроверитьСтроку(ИдентификаторСтроки)
				И СоответствуетОтбору(СтрокаТаблицы, ПараметрыОтбора) Тогда
				
				СтрокаТаблицы.Пометка = Пометка;
				Модифицированность = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбщегоНазначения

Функция СоответствуетОтбору(СтрокаТаблицы, ПараметрыОтбора)
	
	Результат = Истина;
	
	Если ЗначениеЗаполнено(ПараметрыОтбора) Тогда
		
		Для каждого КлючИЗначение Из ПараметрыОтбора Цикл
			
			Если СтрокаТаблицы[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
				
				Результат = Ложь;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти
