// Сериализует значение в строку JSON.
//
// Параметры:
//  Значение - Произвольный - значение, которое требуется сериализовать.
//
// Возвращаемое значение:
//  Строка - JSON-представление значения.
//
Функция СтрокаJSON(Знач Значение) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписатьJSON(ЗаписьJSON, Значение);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

// Десериализует строку JSON в значение.
//
// Параметры:
//  Строка - Строка - JSON-представление значения.
//  ИменаСвойствСоЗначениямиДата - Массив из Строка, Неопределено - имена свойств, значения которых требуется прочитать как дату.
//
// Возвращаемое значение:
//  Произвольный - значение, полученное из строки JSON.
//
Функция ЗначениеJSON(Знач Строка, Знач ИменаСвойствСоЗначениямиДата = Неопределено) Экспорт
	
	Если Строка = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Строка);
	
	Результат = ПрочитатьJSON(ЧтениеJSON, , ИменаСвойствСоЗначениямиДата);
	
	ЧтениеJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

// Вычисляет значение идентификатора из строки соответствии с правилами именования переменных.
// 
// Параметры:
//  СтрокаПредставления - Строка - Наименование, строка из которой необходимо получить идентификатор.
//
// Возвращаемое значение:
//  Строка - Идентификатор, соответствующий правилам именования идентификаторов.
//
Функция ИдентификаторДляФормул(СтрокаПредставления) Экспорт
	
	СпецСимволы = СпецСимволы();
	
	Идентификатор = "";
	БылСпецСимвол = Ложь;
	
	Для НомСимвола = 1 По СтрДлина(СтрокаПредставления) Цикл
		
		Символ = Сред(СтрокаПредставления, НомСимвола, 1);
		
		Если СтрНайти(СпецСимволы, Символ) <> 0 Тогда
			
			БылСпецСимвол = Истина;
			Если Символ = "_" Тогда
				Идентификатор = Идентификатор + Символ;
			КонецЕсли;
			
		ИначеЕсли БылСпецСимвол
			Или НомСимвола = 1 Тогда
			
			БылСпецСимвол = Ложь;
			Идентификатор = Идентификатор + ВРег(Символ);
			
		Иначе
			Идентификатор = Идентификатор + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Идентификатор;
	
КонецФункции

#КонецОбласти

#Область Прочее

// Устанавливает COM-соединение с внешним источником по настройке подключения.
//
// Параметры:
//  НастройкаПодключения - СправочникСсылка.ТБ_НастройкиПодключенияКИсточникам - настройка подключения к источнику.
//
// Возвращаемое значение:
//  Произвольный - установленное COM-соединение или Неопределено, если подключиться не удалось.
//
Функция COMСоединение(Знач НастройкаПодключения) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаПодключения, "ИмяКласса,СтрокаПодключения");
	
	ИмяКласса = ?(ЗначениеЗаполнено(ЗначенияРеквизитов.ИмяКласса),
		ЗначенияРеквизитов.ИмяКласса,
		"V83.COMConnector");
	
	Попытка
		
		COMConnector = Новый COMОбъект(ИмяКласса);
		Соединение = COMConnector.Connect(ЗначенияРеквизитов.СтрокаПодключения);
		
	Исключение
		
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось подключится к базе с настройкой подключения %1 по причине:
			|%2'"), НастройкаПодключения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Сопоставление объектов.Подключение к источнику данных'"),
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		
		COMConnector = Неопределено;
		Соединение   = Неопределено;
		
	КонецПопытки;
	
	Возврат Соединение;
	
КонецФункции

// Сортирует таблицу реквизитов: выбранные реквизиты идут первыми, затем остальные.
//
// Параметры:
//  Таблица - ТаблицаЗначений - таблица реквизитов.
//  ТекущаяСтрока - УникальныйИдентификатор, Неопределено - идентификатор строки, восстанавливаемый после сортировки.
//
Процедура СортироватьТаблицуРеквизитов(Таблица, ТекущаяСтрока = Неопределено) Экспорт
	
	Если ТекущаяСтрока <> Неопределено
		И Таблица.НайтиПоИдентификатору(ТекущаяСтрока) <> Неопределено Тогда
		ИмяРеквизита = Таблица.НайтиПоИдентификатору(ТекущаяСтрока).Имя;
	КонецЕсли;
	
	ТаблицаВыбранныхРеквизитов   = Таблица.Выгрузить(Новый Структура("Пометка", Истина));
	ТаблицаНеВыбранныхРеквизитов = Таблица.Выгрузить(Новый Структура("Пометка", Ложь));
	
	ТаблицаВыбранныхРеквизитов.Сортировать("НомерСтроки");
	ТаблицаНеВыбранныхРеквизитов.Сортировать("Представление");
	
	Таблица.Очистить();
	
	Для каждого СтрокаТаблицы Из ТаблицаВыбранныхРеквизитов Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), СтрокаТаблицы);
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из ТаблицаНеВыбранныхРеквизитов Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), СтрокаТаблицы);
	КонецЦикла;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура("Имя", ИмяРеквизита));
		ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		
	КонецЕсли;
	
КонецПроцедуры

// Добавляет реквизиты таблицы формы по свойствам источника данных.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой добавляются реквизиты.
//  ИмяТаблицы - Строка - имя таблицы формы.
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//  Элемент - Произвольный, Неопределено - элемент, перед которым добавляются поля.
//  ОписаниеОшибок - Массив из Структура, Неопределено - описание возникших ошибок.
//
Процедура ДобавитьРеквизитыВТаблицу(Форма, Знач ИмяТаблицы, Знач СвойстваИсточника, Знач Элемент = Неопределено, ОписаниеОшибок = Неопределено) Экспорт
	
	ОписаниеОшибок = НовоеОписаниеОшибок(ОписаниеОшибок);
	
	Если СвойстваИсточника.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ДобавляемыеРеквизиты = Новый Массив;
		
		Для каждого Свойство Из СвойстваИсточника Цикл
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Свойство.Имя, Новый ОписаниеТипов(Свойство.Тип), ИмяТаблицы));
		КонецЦикла;
		
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		Для каждого Свойство Из СвойстваИсточника Цикл
			
			Если Свойство.Видимость Тогда
				
				НовыйЭлемент = ДобавитьПолеФормы(
					Форма.Элементы, ИмяТаблицы + Свойство.Имя, Свойство.Представление, ИмяТаблицы + "." + Свойство.Имя,
					Форма.Элементы[ИмяТаблицы], Элемент);
				НовыйЭлемент.Ширина = 16;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		
		ДобавитьОписаниеОшибки(ОписаниеОшибок,
			СтрШаблон(НСтр("ru = 'Ошибка при добавлении реквизитов таблицы:
				|%1'"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		
	КонецПопытки;
	
КонецПроцедуры

// Удаляет реквизиты таблицы формы, добавленные по свойствам источника данных.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой удаляются реквизиты.
//  ИмяТаблицы - Строка - имя таблицы формы.
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//  ОписаниеОшибок - Массив из Структура, Неопределено - описание возникших ошибок.
//
Процедура УдалитьРеквизитыВТаблице(Форма, Знач ИмяТаблицы, Знач СвойстваИсточника, ОписаниеОшибок = Неопределено) Экспорт
	
	ОписаниеОшибок = НовоеОписаниеОшибок(ОписаниеОшибок);
	
	Если СвойстваИсточника.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		УдаляемыеРеквизиты = Новый Массив;
		
		Для каждого Свойство Из СвойстваИсточника Цикл
			
			Если Свойство.Видимость Тогда
				Форма.Элементы.Удалить(Форма.Элементы[ИмяТаблицы + Свойство.Имя]);
			КонецЕсли;
			
			УдаляемыеРеквизиты.Добавить(ИмяТаблицы + "." + Свойство.Имя);
			
		КонецЦикла;
		
		Форма.ИзменитьРеквизиты(, УдаляемыеРеквизиты);
		
	Исключение
		
		ДобавитьОписаниеОшибки(ОписаниеОшибок,
			СтрШаблон(НСтр("ru = 'Ошибка при удалении реквизитов таблицы:
				|%1'"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		
	КонецПопытки;
	
КонецПроцедуры

// Возвращает коллекцию описания ошибок, создавая её при необходимости.
//
// Параметры:
//  ОписаниеОшибок - Массив из Структура, Неопределено - существующая коллекция описания ошибок.
//
// Возвращаемое значение:
//  Массив из Структура - коллекция описания ошибок.
//
Функция НовоеОписаниеОшибок(ОписаниеОшибок = Неопределено) Экспорт
	
	Если ОписаниеОшибок = Неопределено Тогда
		ОписаниеОшибок = Новый Массив;
	КонецЕсли;
	
	Возврат ОписаниеОшибок;
	
КонецФункции

// Добавляет описание ошибки в коллекцию и устанавливает признак отказа.
//
// Параметры:
//  ОписаниеОшибок - Массив из Структура - коллекция описания ошибок.
//  ТекстОшибки - Строка - текст ошибки.
//  ИдентификаторСтроки - Число, Неопределено - номер строки данных, к которой относится ошибка.
//  Отказ - Булево - признак отказа от выполнения операции.
//
Процедура ДобавитьОписаниеОшибки(ОписаниеОшибок, Знач ТекстОшибки, Знач ИдентификаторСтроки = Неопределено, Отказ = Ложь) Экспорт
	
	Описание = Новый Структура;
	Описание.Вставить("ТекстОшибки",         ТекстОшибки);
	Описание.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
	
	ОписаниеОшибок.Добавить(Описание);
	Отказ = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСообщенияВОписаниеОшибок(ПараметрыСопоставления)
	
	Если ПараметрыСопоставления.ВыводитьСообщения Тогда
		
		Для каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок, Сообщение.Текст);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#Область СпискиВыбора

Процедура ДобавитьФормуСписка(СписокВыбора, Знач ИмяФормы)
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяФормы);
	Представление    = СтрШаблон("%1 (%2)", ОбъектМетаданных.Родитель().Представление(), ОбъектМетаданных.Представление());
	
	СписокВыбора.Добавить(ИмяФормы, Представление);
	
КонецПроцедуры

#КонецОбласти

#Область ТаблицаИсточника

// Возвращает структуру параметров источника данных.
//
// Параметры:
//  ИсточникДанных - СправочникСсылка.ТБ_ИсточникиДанных - источник данных.
//
// Возвращаемое значение:
//  Структура - параметры источника данных:
//   * ТипИсточника - ПеречислениеСсылка.ТБ_ТипыИсточниковДанных - тип источника данных;
//   * ИмяТаблицыВнешнегоИсточника - Строка - имя таблицы внешнего источника;
//   * НастройкаПодключения - СправочникСсылка.ТБ_НастройкиПодключенияКИсточникам - настройка подключения;
//   * ТекстЗапроса - Строка - текст запроса к источнику;
//   * ПараметрыЗапроса - Строка - параметры запроса к источнику;
//   * ОптимизированноеПолучениеДанных - Булево - признак оптимизированного получения данных;
//   * ИспользуетсяПланОбмена - Булево - признак использования плана обмена;
//   * КодУзлаПланаОбмена - Строка - код узла плана обмена;
//   * ИмяОбъектаПланаОбмена - Строка - имя объекта плана обмена;
//   * КодОбработкиДанныхЗапроса - Строка - код обработки данных запроса.
//
Функция ПараметрыИсточника(Знач ИсточникДанных) Экспорт
	
	ПараметрыИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсточникДанных,
		"ТипИсточника,
		|ИмяТаблицыВнешнегоИсточника,
		|НастройкаПодключения,ТекстЗапроса,ПараметрыЗапроса,ОптимизированноеПолучениеДанных,
		|ИспользуетсяПланОбмена,КодУзлаПланаОбмена,ИмяОбъектаПланаОбмена,КодОбработкиДанныхЗапроса");
	
	ПараметрыИсточника.ИспользуетсяПланОбмена = ПараметрыИсточника.ИспользуетсяПланОбмена
		И ПараметрыИсточника.ТипИсточника = Перечисления.ТБ_ТипыИсточниковДанных.COM1C;
	
	Возврат ПараметрыИсточника;
	
КонецФункции

Процедура ЗагрузитьИзТаблицыВнешнегоИсточника(ТаблицаИсточника, Знач ПараметрыИсточника, Знач СвойстваИсточника = Неопределено,
	Знач ПараметрыОтбора = Неопределено, Знач Различные = Ложь)
	
	Если Не ЗначениеЗаполнено(ПараметрыИсточника.ИмяТаблицыВнешнегоИсточника) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	#ТаблицаВнешнегоИсточника КАК ТаблицаВнешнегоИсточника
	|ГДЕ
	|	&Отбор";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", ТекстЗапросаРазличные(Различные));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "*", ТекстЗапросаПоляТаблицы("ТаблицаВнешнегоИсточника", СвойстваИсточника));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Отбор", ТекстЗапросаОтбор("ТаблицаВнешнегоИсточника", ПараметрыОтбора));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ТаблицаВнешнегоИсточника", ПараметрыИсточника.ИмяТаблицыВнешнегоИсточника);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	УстановитьПараметрыОтбора(Запрос, ПараметрыОтбора);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаИсточника.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьПостобработчикЗапроса(ПараметрыИсточника, ТаблицаИсточника, Знач Соединение)
	
	ТекстОбработчика = ПараметрыИсточника.КодОбработкиДанныхЗапроса;
	Если ПустаяСтрока(ТекстОбработчика) Тогда 
		Возврат;
	КонецЕсли;
	
	УстановитьБезопасныйРежим(Истина);
	Попытка
		Выполнить(ПараметрыИсточника.КодОбработкиДанныхЗапроса);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Сопоставление объектов.Постобработчик запроса'"),
			УровеньЖурналаРегистрации.Предупреждение, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УстановитьБезопасныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗагрузитьИзТаблицыCOMСоединения(ТаблицаИсточника, Знач ПараметрыИсточника, Знач СвойстваИсточника,
	Знач ПараметрыОтбора = Неопределено, Знач Различные = Ложь, Соединение = Неопределено)
	
	Если Соединение = Неопределено Тогда
		
		Соединение = ТБ_СопоставлениеОбъектовПовтИсп.COMСоединение(ПараметрыИсточника.НастройкаПодключения);
		Если Соединение = Неопределено Тогда
			
			ТекстСообщения = НСтр("ru = 'При подключении к источнику возникли ошибки (см. Журнал регистрации).'");
			ВызватьИсключение ТекстСообщения;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//
	
	СхемаЗапроса = Соединение.NewObject("СхемаЗапроса");
	СхемаЗапроса.РежимКомпоновкиДанных = Истина;
	СхемаЗапроса.УстановитьТекстЗапроса(ПараметрыИсточника.ТекстЗапроса);
	
	ЗапросВыбора = СхемаЗапроса.ПакетЗапросов.Получить(СхемаЗапроса.ПакетЗапросов.Количество() - 1);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	(#ТекстВложенногоЗапроса) КАК ВложенныйЗапрос
	|ГДЕ
	|	&Отбор";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", ТекстЗапросаРазличные(Различные));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "*", ТекстЗапросаПоляТаблицы("ВложенныйЗапрос", СвойстваИсточника));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Отбор", ТекстЗапросаОтбор("ВложенныйЗапрос", ПараметрыОтбора));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ТекстВложенногоЗапроса", ЗапросВыбора.ПолучитьТекстЗапроса());
	
	ЗапросВыбора.УстановитьТекстЗапроса(ТекстЗапроса);
	
	ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	//
	
	Запрос = Соединение.NewObject("Запрос");
	
	Если ЗначениеЗаполнено(ПараметрыИсточника.ПараметрыЗапроса) Тогда
		
		ПараметрыЗапроса = Соединение.NewObject("Структура");
		
		Соединение.ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПараметрыИсточника.ПараметрыЗапроса, ПараметрыЗапроса);
		
		Для каждого Элемент Из ПараметрыЗапроса Цикл
			Запрос.Параметры.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Если ПараметрыИсточника.ИспользуетсяПланОбмена Тогда
		
		ТаблицаИзменений = Соединение.ПланыОбмена.ТБ_ОбменСопоставлениеОбъектов.ВыбратьИзменения(
			ПараметрыИсточника.КодУзлаПланаОбмена,
			ПараметрыИсточника.ИмяОбъектаПланаОбмена);
		
		Запрос.УстановитьПараметр("ТаблицаИзменений", ТаблицаИзменений);
		
	КонецЕсли;
	
	УстановитьПараметрыОтбораCOM(Соединение, Запрос, ПараметрыОтбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Если ПараметрыИсточника.ОптимизированноеПолучениеДанных Тогда
			
			Строка = Соединение.ЗначениеВСтрокуВнутр(РезультатЗапроса.Выгрузить());
			ТаблицаИсточника = ЗначениеИзСтрокиВнутр(Строка);
			
		Иначе
			ЗаполнитьТаблицуCOMСоединение(ТаблицаИсточника, РезультатЗапроса, Соединение);
			ВыполнитьПостобработчикЗапроса(ПараметрыИсточника, ТаблицаИсточника, Соединение);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуCOMСоединение(ТаблицаИсточника, Знач РезультатЗапроса, Знач Соединение)
	
	ИменаПолей = Новый Массив;
	
	Для каждого Поле Из РезультатЗапроса.Колонки Цикл
		ИменаПолей.Добавить(Поле.Имя);
	КонецЦикла;
	
	ПростыеТипы = Новый Массив;
	ПростыеТипы.Добавить(Тип("Число"));
	ПростыеТипы.Добавить(Тип("Строка"));
	ПростыеТипы.Добавить(Тип("Булево"));
	ПростыеТипы.Добавить(Тип("Дата"));
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаИсточника.Добавить();
		
		Для каждого ИмяПоля Из ИменаПолей Цикл
			
			Значение = Выборка[ИмяПоля];
			
			Попытка
				
				НоваяСтрока[ИмяПоля] = ?(ПростыеТипы.Найти(ТипЗнч(Значение)) = Неопределено,
					Соединение.XMLСтрока(Значение),
					Значение);
				
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Сопоставление объектов.Преобразование значения поля источника'"),
					УровеньЖурналаРегистрации.Предупреждение, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаРазличные(Знач Различные)
	
	Возврат ?(Различные, "ВЫБРАТЬ РАЗЛИЧНЫЕ", "ВЫБРАТЬ");
	
КонецФункции

Функция ТекстЗапросаПоляТаблицы(Знач ИмяТаблицы, Знач СвойстваИсточника = Неопределено)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(СвойстваИсточника) Тогда
		
		ЗначенияПоУмолчанию = Новый Соответствие;
		ЗначенияПоУмолчанию.Вставить("Число",  "0");
		ЗначенияПоУмолчанию.Вставить("Строка", """""");
		ЗначенияПоУмолчанию.Вставить("Дата",   "ДАТАВРЕМЯ(1, 1, 1)");
		ЗначенияПоУмолчанию.Вставить("Булево", "ЛОЖЬ");
		
		Строки = Новый Массив;
		
		Для каждого Свойство Из СвойстваИсточника Цикл
			Строки.Добавить(СтрШаблон("ЕСТЬNULL(%1.%2, %3) КАК %2", ИмяТаблицы, Свойство.Имя, ЗначенияПоУмолчанию.Получить(Свойство.Тип)));
			//Строки.Добавить(СтрШаблон("%1.%2 КАК %2", ИмяТаблицы, Свойство.Имя));
		КонецЦикла;
		
		Результат = СтрСоединить(Строки, ",
			|	");
		
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(Результат), Результат, "*");
	
КонецФункции

Функция ТекстЗапросаОтбор(Знач ИмяТаблицы, Знач ПараметрыОтбора)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(ПараметрыОтбора) Тогда
		
		Строки = Новый Массив;
		
		ЗначенияПоУмолчанию = Новый Соответствие;
		ЗначенияПоУмолчанию.Вставить("Число",  "0");
		ЗначенияПоУмолчанию.Вставить("Строка", """""");
		ЗначенияПоУмолчанию.Вставить("Дата",   "ДАТАВРЕМЯ(1, 1, 1)");
		ЗначенияПоУмолчанию.Вставить("Булево", "ЛОЖЬ");
		
		Для каждого ЭлементОтбора Из ПараметрыОтбора Цикл
			Строки.Добавить(СтрШаблон("ЕСТЬNULL(%1.%2, %3) = &%2", ИмяТаблицы, ЭлементОтбора.Ключ, ЗначенияПоУмолчанию.Получить(ЭлементОтбора.Значение.Тип)));
		КонецЦикла;
		
		Результат = СтрСоединить(Строки, "
			|	И ");
		
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(Результат), Результат, "ИСТИНА");
	
КонецФункции

Процедура УстановитьПараметрыОтбора(Запрос, Знач ПараметрыОтбора)
	
	Если ЗначениеЗаполнено(ПараметрыОтбора) Тогда
		
		Для каждого ЭлементОтбора Из ПараметрыОтбора Цикл
			Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьПараметрыОтбораCOM(Соединение, Запрос, Знач ПараметрыОтбора)
	
	Если ЗначениеЗаполнено(ПараметрыОтбора) Тогда
		
		Для каждого ЭлементОтбора Из ПараметрыОтбора Цикл
			
			ПараметрыПоля = ЭлементОтбора.Значение;
			
			Если ЗначениеЗаполнено(ПараметрыПоля.ТипСсылки) Тогда
				
				Менеджер = МенеджерОбъектаПоПолномуИмениCOM(Соединение, ПараметрыПоля.ТипСсылки);
				Значение = Менеджер.ПолучитьСсылку(Соединение.NewObject("УникальныйИдентификатор", ПараметрыПоля.Значение));
				
			Иначе
				Значение = ПараметрыПоля.Значение;
			КонецЕсли;
			
			Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция МенеджерОбъектаПоПолномуИмениCOM(Соединение, Знач ПолноеИмя)
	
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
	
	Если ЧастиИмени.Количество() = 2 Тогда
		
		КлассОМ = ВРег(ЧастиИмени[0]);
		ИмяОМ   = ЧастиИмени[1];
		
		Если КлассОМ = "ПЛАНОБМЕНА" Тогда
			
			Возврат Соединение.ПланыОбмена[ИмяОМ];
			
		ИначеЕсли КлассОМ = "СПРАВОЧНИК" Тогда
			
			Возврат Соединение.Справочники[ИмяОМ];
			
		ИначеЕсли КлассОМ = "ДОКУМЕНТ" Тогда
			
			Возврат Соединение.Документы[ИмяОМ];
			
		ИначеЕсли КлассОМ = "ПЕРЕЧИСЛЕНИЕ" Тогда
			
			Возврат Соединение.Перечисления[ИмяОМ];
			
		ИначеЕсли КлассОМ = "ПЛАНВИДОВХАРАКТЕРИСТИК" Тогда
			
			Возврат Соединение.ПланыВидовХарактеристик[ИмяОМ];
			
		ИначеЕсли КлассОМ = "ПЛАНСЧЕТОВ" Тогда
			
			Возврат Соединение.ПланыСчетов[ИмяОМ];
			
		ИначеЕсли КлассОМ = "ПЛАНВИДОВРАСЧЕТА" Тогда
			
			Возврат Соединение.ПланыВидовРасчета[ИмяОМ];
			
		ИначеЕсли КлассОМ = "БИЗНЕСПРОЦЕСС" Тогда
			
			Возврат Соединение.БизнесПроцессы[ИмяОМ];
			
		ИначеЕсли КлассОМ = "ЗАДАЧА" Тогда
			
			Возврат Соединение.Задачи[ИмяОМ];
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

