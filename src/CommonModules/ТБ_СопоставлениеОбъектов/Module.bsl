Процедура ЗаполнитьТаблицуРеквизитов(Таблица, Знач Правило)
	
	Таблица.Очистить();
	
	Если ЗначениеЗаполнено(Правило) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Реквизиты.НомерСтроки КАК НомерСтроки,
		|	Реквизиты.Поиск КАК Поиск,
		|	Реквизиты.Имя КАК Имя,
		|	Реквизиты.Представление КАК Представление,
		|	Реквизиты.ВариантЗаполнения КАК ВариантЗаполнения,
		|	Реквизиты.СвойствоИсточника КАК СвойствоИсточника,
		|	Реквизиты.Обработчик КАК Обработчик,
		|	Реквизиты.ТипЗначенияХранилище КАК ТипЗначенияХранилище,
		|	Реквизиты.ЗначениеХранилище КАК ЗначениеХранилище,
		|	Реквизиты.ЗаполнятьОбязательно КАК ЗаполнятьОбязательно
		|ИЗ
		|	Справочник.ТБ_ПравилаСопоставления.Реквизиты КАК Реквизиты
		|ГДЕ
		|	Реквизиты.Ссылка = &Правило
		|	И Реквизиты.Пометка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки");
		
		Запрос.УстановитьПараметр("Правило", Правило);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			НоваяСтрока.ТипЗначения = Выборка.ТипЗначенияХранилище.Получить();
			НоваяСтрока.Значение    = Выборка.ЗначениеХранилище.Получить();
			НоваяСтрока.ПолноеИмя   = "Объект_" + НоваяСтрока.Имя;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

