	Попытка
		ВыполнитьКодОбработчикаПослеЗаписи(Объект, ПараметрыОбъекта.ОбработчикПослеЗаписи, ДанныеИсточника, Отказ);
	Исключение
		
		ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
			СтрШаблон(НСтр("ru = 'Ошибка выполнения обработчика ПослеЗаписи для объекта ""%1"":
