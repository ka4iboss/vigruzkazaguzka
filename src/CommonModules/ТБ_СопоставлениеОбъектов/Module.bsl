#Область ЭлементыРеквизитыФормы

// Проверяет, создан ли на форме реквизит с указанным именем.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой проверяется реквизит.
//  ИмяРеквизита - Строка - имя проверяемого реквизита.
//
// Возвращаемое значение:
//  Булево - Истина, если реквизит создан на форме.
//
Функция РеквизитСоздан(Форма, Знач ИмяРеквизита) Экспорт
	
	ЗначениеПоУмолчанию = Новый УникальныйИдентификатор;
	
	СтруктураСвойств = Новый Структура(ИмяРеквизита, ЗначениеПоУмолчанию);
	ЗаполнитьЗначенияСвойств(СтруктураСвойств, Форма);
	
	Возврат СтруктураСвойств[ИмяРеквизита] <> ЗначениеПоУмолчанию;
	
КонецФункции

// Добавляет команду формы и возвращает её.
//
// Параметры:
//  Команды - КомандыФормы - коллекция команд формы.
//  Имя - Строка - имя команды.
//  Заголовок - Строка - заголовок команды.
//  Действие - Строка - имя процедуры-обработчика действия команды.
//  ИзменяетСохраняемыеДанные - Булево - признак того, что команда изменяет сохраняемые данные.
//
// Возвращаемое значение:
//  КомандаФормы - добавленная команда формы.
//
Функция ДобавитьКоманду(Команды, Знач Имя, Знач Заголовок, Знач Действие, Знач ИзменяетСохраняемыеДанные = Ложь) Экспорт
	
	НоваяКоманда = Команды.Добавить(Имя);
	НоваяКоманда.Заголовок                 = Заголовок;
	НоваяКоманда.Действие                  = Действие;
	НоваяКоманда.ИзменяетСохраняемыеДанные = ИзменяетСохраняемыеДанные;
	
	Возврат НоваяКоманда;
	
КонецФункции

// Добавляет группу формы и возвращает её.
//
// Параметры:
//  Элементы - ВсеЭлементыФормы - коллекция элементов формы.
//  Имя - Строка - имя группы.
//  Заголовок - Строка - заголовок группы.
//  Родитель - Произвольный, Неопределено - родительский элемент группы.
//  Элемент - Произвольный, Неопределено - элемент, перед которым добавляется группа.
//  Вид - ВидГруппыФормы, Неопределено - вид группы формы.
//
// Возвращаемое значение:
//  ГруппаФормы - добавленная группа формы.
//
Функция ДобавитьГруппуФормы(Элементы, Знач Имя, Знач Заголовок, Знач Родитель = Неопределено, Знач Элемент = Неопределено, Знач Вид = Неопределено) Экспорт
	
	Если Элемент = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	Иначе
		НовыйЭлемент = Элементы.Вставить(Имя, Тип("ГруппаФормы"), Родитель, Элемент);
	КонецЕсли;
	
	НовыйЭлемент.Вид       = ?(Вид = Неопределено, ВидГруппыФормы.ОбычнаяГруппа, Вид);
	НовыйЭлемент.Заголовок = Заголовок;
	
	Возврат НовыйЭлемент;
	
КонецФункции

// Добавляет таблицу формы и возвращает её.
//
// Параметры:
//  Элементы - ВсеЭлементыФормы - коллекция элементов формы.
//  Имя - Строка - имя таблицы.
//  Заголовок - Строка - заголовок таблицы.
//  ПутьКДанным - Строка - путь к данным таблицы.
//  Родитель - Произвольный, Неопределено - родительский элемент таблицы.
