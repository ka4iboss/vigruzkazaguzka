#Область ПолучениеЗначений

Функция ПолучитьЗначение(СтрокаТаблицы, Знач ДанныеИсточника, ПараметрыСопоставления, Знач ЭтоДопРеквизит, Отказ)
	
	Если СтрокаТаблицы.ВариантЗаполнения = Перечисления.ТБ_ВариантыЗаполнения.Значение Тогда
		
		Возврат СтрокаТаблицы.Значение;
		
	ИначеЕсли СтрокаТаблицы.ВариантЗаполнения = Перечисления.ТБ_ВариантыЗаполнения.ЗначениеИсточника Тогда
		
		Возврат ДанныеИсточника[СтрокаТаблицы.СвойствоИсточника];
		
	ИначеЕсли СтрокаТаблицы.ВариантЗаполнения = Перечисления.ТБ_ВариантыЗаполнения.ПоискПоКоду Тогда
		
		Возврат НайтиЗначениеПоКоду(СтрокаТаблицы, ДанныеИсточника, ПараметрыСопоставления, Отказ);
		
	ИначеЕсли СтрокаТаблицы.ВариантЗаполнения = Перечисления.ТБ_ВариантыЗаполнения.ПоискПоНаименованию Тогда
		
		Возврат НайтиЗначениеПоНаименованию(СтрокаТаблицы, ДанныеИсточника, ПараметрыСопоставления, ЭтоДопРеквизит, Отказ);
		
	ИначеЕсли СтрокаТаблицы.ВариантЗаполнения = Перечисления.ТБ_ВариантыЗаполнения.ПоискПоСоответствию Тогда
		
		Возврат НайтиЗначениеПоСоответствию(СтрокаТаблицы, ДанныеИсточника, ПараметрыСопоставления, Отказ);
		
	ИначеЕсли СтрокаТаблицы.ВариантЗаполнения = Перечисления.ТБ_ВариантыЗаполнения.Обработчик Тогда
		
		ИсполняемыйКод = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы.Обработчик, "ОбработчикЗаполнения");
		
		Свойство = ?(ЭтоДопРеквизит, СтрокаТаблицы.Свойство, Неопределено);
		
		Значение = ВыполнитьКодОбработчикаЗаполнения(ИсполняемыйКод, ДанныеИсточника, Свойство, Отказ);
		
		ДобавитьСообщенияВОписаниеОшибок(ПараметрыСопоставления);
		
		Возврат Значение;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиЗначениеПоКоду(СтрокаТаблицы, Знач ДанныеИсточника, ПараметрыСопоставления, Отказ)
	
	Результат = Неопределено;
	
	Типы = СтрокаТаблицы.ТипЗначения.Типы();
	ТипЗначения = ?(Типы.Количество() = 1, Типы[0], ТипЗнч(СтрокаТаблицы.Значение));
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗначения) Тогда
		
		Код = ДанныеИсточника[СтрокаТаблицы.СвойствоИсточника];
		
		Если Не ЗначениеЗаполнено(Код) Тогда
			Возврат Новый(ТипЗначения);
		КонецЕсли;
		
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Новый(ТипЗначения));
		Результат = МенеджерОбъекта.НайтиПоКоду(Код);
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			
			ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
				СтрШаблон(НСтр("ru = 'Не найдено значение реквизита ""%1"" по коду ""%2""'"),
					СтрокаТаблицы.Представление,
					Код),
				,
				Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиЗначениеПоНаименованию(СтрокаТаблицы, Знач ДанныеИсточника, ПараметрыСопоставления, Знач ЭтоДопРеквизит, Отказ)
	
	Результат = Неопределено;
	
	Типы = СтрокаТаблицы.ТипЗначения.Типы();
	ТипЗначения = ?(Типы.Количество() = 1, Типы[0], ТипЗнч(СтрокаТаблицы.Значение));
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗначения) Тогда
		
		Наименование = ДанныеИсточника[СтрокаТаблицы.СвойствоИсточника];
		
		Если Не ЗначениеЗаполнено(Наименование) Тогда
			Возврат Новый(ТипЗначения);
		КонецЕсли;
		
		Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			
			Результат = Новый(ТипЗначения);
			МетаданныеОбъекта = Результат.Метаданные();
			
			Для каждого ЗначениеПеречисления Из МетаданныеОбъекта.ЗначенияПеречисления Цикл
				
				Если ЗначениеПеречисления.Синоним = Наименование Тогда
					
					МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Результат);
					Результат = МенеджерОбъекта[ЗначениеПеречисления.Имя];
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ЭтоДопРеквизит И ТипЗначения = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда // значение свойства доп. реквизита
			
			Результат = ТБ_ЗагрузкаОбъектов.НайтиЗначениеСвойстваПоНаименованию(Наименование, СтрокаТаблицы.Свойство);
			
			Если Не ЗначениеЗаполнено(Результат)
				И ПараметрыСопоставления.СоздаватьНовыеЗначенияСвойств Тогда
				
				Объект = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
				Объект.Владелец     = СтрокаТаблицы.Свойство;
				Объект.Наименование = Наименование;
				Объект.Записать();
				
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Создано новое значение свойства для доп. реквизита ""%1"": %2'"),
					СтрокаТаблицы.Представление,
					Объект.Ссылка);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				ПараметрыСопоставления.СозданныеОбъекты.Добавить(Объект.Ссылка);
				
				Результат = Объект.Ссылка;
				
			КонецЕсли;
			
		Иначе
			
			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Новый(ТипЗначения));
			Результат = МенеджерОбъекта.НайтиПоНаименованию(Наименование, Истина);
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			
			ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
				СтрШаблон(НСтр("ru = 'Не найдено значение реквизита ""%1"" по наименованию ""%2""'"),
					СтрокаТаблицы.Представление,
					Наименование),
				,
				Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиЗначениеПоСоответствию(СтрокаТаблицы, Знач ДанныеИсточника, ПараметрыСопоставления, Отказ)
	
	Результат = Неопределено;
	
	Типы = СтрокаТаблицы.ТипЗначения.Типы();
	ТипЗначения = ?(Типы.Количество() = 1, Типы[0], ТипЗнч(СтрокаТаблицы.Значение));
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗначения) Тогда
		
		Идентификатор = ДанныеИсточника[СтрокаТаблицы.СвойствоИсточника];
		
		Если Не ЗначениеЗаполнено(Идентификатор) Тогда
			Возврат Новый(ТипЗначения);
		КонецЕсли;
		
		Результат = РегистрыСведений.ТБ_СоответствияОбъектов.НайтиОбъектПоСоответствию(Идентификатор, ТипЗначения);
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			
			ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
				СтрШаблон(НСтр("ru = 'Не найдено значение реквизита ""%1"" по соответствию ""%2""'"),
					СтрокаТаблицы.Представление,
					Идентификатор),
				,
				Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВыполнитьКодОбработчикаЗаполнения(Знач ИсполняемыйКод, Знач ДанныеИсточника, Знач Свойство, Отказ)
	
	Значение = Неопределено;
	
	УстановитьБезопасныйРежим(Истина);
	Выполнить(ИсполняемыйКод);
	УстановитьБезопасныйРежим(Ложь);
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти

#Область Сопоставление

#Область ПараметрыОбъекта

// Возвращает структуру параметров сопоставляемого объекта по правилу сопоставления.
//
// Параметры:
//  Правило - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//
// Возвращаемое значение:
//  Структура - параметры сопоставляемого объекта:
//   * ПолноеИмяОбъекта - Строка - полное имя объекта метаданных;
//   * ПредставлениеОбъекта - Строка - представление объекта;
//   * МенеджерОбъекта - СправочникМенеджерИмяСправочника, ДокументМенеджерИмяДокумента, ПланВидовХарактеристикМенеджерИмяПланаВидовХарактеристик, ПланСчетовМенеджерИмяПланаСчетов, ПланВидовРасчетаМенеджерИмяПланаВидовРасчета, ПланОбменаМенеджерИмяПланаОбмена, РегистрСведенийМенеджерИмяРегистраСведений, РегистрНакопленияМенеджерИмяРегистраНакопления, РегистрБухгалтерииМенеджерИмяРегистраБухгалтерии, РегистрРасчетаМенеджерИмяРегистраРасчета, БизнесПроцессМенеджерИмяБизнесПроцесса, ЗадачаМенеджерИмяЗадачи, ЖурналДокументовМенеджерИмяЖурналаДокументов, ПоследовательностьМенеджерИмяПоследовательности, КонстантаМенеджерИмяКонстанты, ОбработкаМенеджерИмяОбработки, ОтчетМенеджерИмяОтчета, ПеречислениеМенеджерИмяПеречисления - менеджер объекта;
//   * ИменаРеквизитов - Массив из Строка - имена реквизитов объекта;
//   * РеквизитыОбъекта - Соответствие из КлючИЗначение - описания реквизитов объекта;
//   * ДопРеквизитыОбъекта - Соответствие из КлючИЗначение - описания дополнительных реквизитов объекта;
//   * ПоляПоиска - Массив из Строка - имена полей поиска;
//   * ДопПоляПоиска - Массив из Строка - имена дополнительных полей поиска;
//   * ВсеПоляПоиска - Массив из Строка - имена всех полей поиска;
//   * СвойстваПоиска - Массив из Произвольный - свойства дополнительных реквизитов поиска;
//   * ИменаДопПолейПоиска - Строка - имена дополнительных полей поиска;
//   * ИменаВсехПолейПоиска - Строка - имена всех полей поиска;
//   * ТекстЗапросаПоиска - Строка - текст запроса поиска объектов;
//   * ОбработчикПередОбработкой - Строка - код обработчика ПередОбработкой;
//   * ОбработчикПослеЗаполненияСтрокиТаблицы - Строка - код обработчика ПослеЗаполненияСтрокиТаблицы;
//   * ОбработчикПередЗаписью - Строка - код обработчика ПередЗаписью;
//   * ОбработчикПослеЗаписи - Строка - код обработчика ПослеЗаписи;
//   * СоздаватьГруппы - Булево - признак создания групп.
//
Функция ПараметрыОбъекта(Знач Правило, ПараметрыСопоставления) Экспорт
	
	ИменаРеквизитов     = Новый Массив;
	РеквизитыОбъекта    = Новый Соответствие;
	ДопРеквизитыОбъекта = Новый Соответствие;
	ПоляПоиска          = Новый Массив;
	ДопПоляПоиска       = Новый Массив;
	СвойстваПоиска      = Новый Массив;
	
	// Реквизиты объекта.
	Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаРеквизитов Цикл
		
		ИменаРеквизитов.Добавить(СтрокаТаблицы.Имя);
		
		ОписаниеРеквизита = Новый Структура("ТипЗначения,Представление");
		ЗаполнитьЗначенияСвойств(ОписаниеРеквизита, СтрокаТаблицы);
		
		РеквизитыОбъекта.Вставить(СтрокаТаблицы.Имя, ОписаниеРеквизита);
		
		Если СтрокаТаблицы.Поиск Тогда
			ПоляПоиска.Добавить(СтрокаТаблицы.Имя);
		КонецЕсли;
		
	КонецЦикла;
	
	// Дополнительные реквизиты объекта.
	Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаДопРеквизитов Цикл
		
		ОписаниеРеквизита = Новый Структура("Свойство,ТипЗначения,Представление");
		ЗаполнитьЗначенияСвойств(ОписаниеРеквизита, СтрокаТаблицы);
		
		ДопРеквизитыОбъекта.Вставить(СтрокаТаблицы.Имя, ОписаниеРеквизита);
		
		Если СтрокаТаблицы.Поиск Тогда
			
			ДопПоляПоиска.Добавить(СтрокаТаблицы.Имя);
			СвойстваПоиска.Добавить(СтрокаТаблицы.Свойство);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ВсеПоляПоиска = Новый Массив;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеПоляПоиска, ПоляПоиска);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеПоляПоиска, ДопПоляПоиска);
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Правило,
		"ИмяОбъекта,ПредставлениеОбъекта,
		|ОбработчикПередОбработкой,ОбработчикПослеЗаполненияСтрокиТаблицы,ОбработчикПередЗаписью,ОбработчикПослеЗаписи,СоздаватьГруппы");
	
	ПолноеИмяОбъекта = ЗначенияРеквизитов.ИмяОбъекта;
	МенеджерОбъекта  = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяОбъекта);
	
	ПоляЗапроса    = ПоляЗапросаПоиска(ПоляПоиска, ДопПоляПоиска);
	УсловияЗапроса = УсловияЗапросаПоиска(ПоляПоиска);
	
	Если ДопПоляПоиска.Количество() = 0 Тогда
		ТекстЗапросаПоиска = ТекстЗапросаПоиска(ПолноеИмяОбъекта, ПоляЗапроса, УсловияЗапроса);
	Иначе
		ТекстЗапросаПоиска = ТекстЗапросаПоискаПоДопРеквизитам(ПолноеИмяОбъекта, ПоляЗапроса, УсловияЗапроса);
	КонецЕсли;
	
	//
	
	Результат = Новый Структура;
	Результат.Вставить("ПолноеИмяОбъекта",       ПолноеИмяОбъекта);
	Результат.Вставить("ПредставлениеОбъекта",   ЗначенияРеквизитов.ПредставлениеОбъекта);
	Результат.Вставить("МенеджерОбъекта",        МенеджерОбъекта);
	
	Результат.Вставить("ИменаРеквизитов",        ИменаРеквизитов);
	Результат.Вставить("РеквизитыОбъекта",       РеквизитыОбъекта);
	Результат.Вставить("ДопРеквизитыОбъекта",    ДопРеквизитыОбъекта);
	
	Результат.Вставить("ПоляПоиска",             ПоляПоиска);
	Результат.Вставить("ДопПоляПоиска",          ДопПоляПоиска);
	Результат.Вставить("ВсеПоляПоиска",          ВсеПоляПоиска);
	Результат.Вставить("СвойстваПоиска",         СвойстваПоиска);
	Результат.Вставить("ИменаДопПолейПоиска",    СтрСоединить(ДопПоляПоиска, ","));
	Результат.Вставить("ИменаВсехПолейПоиска",   СтрСоединить(ВсеПоляПоиска, ","));
	Результат.Вставить("ТекстЗапросаПоиска",     ТекстЗапросаПоиска);
	
	Результат.Вставить("ОбработчикПередОбработкой", ЗначенияРеквизитов.ОбработчикПередОбработкой);
	Результат.Вставить("ОбработчикПослеЗаполненияСтрокиТаблицы", ЗначенияРеквизитов.ОбработчикПослеЗаполненияСтрокиТаблицы);
	Результат.Вставить("ОбработчикПередЗаписью", ЗначенияРеквизитов.ОбработчикПередЗаписью);
	Результат.Вставить("ОбработчикПослеЗаписи",  ЗначенияРеквизитов.ОбработчикПослеЗаписи);
	
	Результат.Вставить("СоздаватьГруппы",  ЗначенияРеквизитов.СоздаватьГруппы);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаПоиска(Знач ПолноеИмяОбъекта, Знач ПоляЗапроса, Знач УсловияЗапроса)
	
	ТекстЗапроса = СтрШаблон(
	"ВЫБРАТЬ
	|	%2
	|ПОМЕСТИТЬ РеквизитыПоиска
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеквизитыПоиска.*,
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	%1 КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РеквизитыПоиска КАК РеквизитыПоиска
	|		ПО %3",
	ПолноеИмяОбъекта,
	ПоляЗапроса,
	УсловияЗапроса);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаПоискаПоДопРеквизитам(Знач ПолноеИмяОбъекта, Знач ПоляЗапроса, Знач УсловияЗапроса)
	
	ТекстЗапроса = СтрШаблон(
	"ВЫБРАТЬ
	|	%2
	|ПОМЕСТИТЬ РеквизитыПоиска
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеквизитыПоиска.*,
	|	Таблица.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	%1 КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РеквизитыПоиска КАК РеквизитыПоиска
	|		ПО %3
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	Таблица.*
	|ИЗ
	|	Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Таблица.Ссылка КАК Ссылка,
	|	ДопРеквизиты.Свойство.Имя КАК Имя,
	|	ДопРеквизиты.Свойство КАК Свойство,
	|	ДопРеквизиты.Значение КАК Значение
	|ИЗ
	|	Таблица КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ %1.ДополнительныеРеквизиты КАК ДопРеквизиты
	|		ПО Таблица.Ссылка = ДопРеквизиты.Ссылка
	|			И (ДопРеквизиты.Свойство В (&СвойстваПоиска))
	|ИТОГИ ПО
	|	Ссылка",
	ПолноеИмяОбъекта,
	ПоляЗапроса,
	УсловияЗапроса);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПоляЗапросаПоиска(Знач ПоляПоиска, Знач ДопПоляПоиска)
	
	Строки = Новый Массив;
	
	Для каждого Поле Из ПоляПоиска Цикл
		
		Если Поле = "Комментарий" Тогда // исключение, поиск по Комментарию
			Строки.Добавить(СтрШаблон("ВЫРАЗИТЬ(&%1 КАК СТРОКА(1024)) КАК %1", Поле));
		Иначе
			Строки.Добавить(СтрШаблон("&%1 КАК %1", Поле));
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого Поле Из ДопПоляПоиска Цикл
		Строки.Добавить(СтрШаблон("&%1 КАК %1", Поле));
	КонецЦикла;
	
	ПоляЗапроса = СтрСоединить(Строки, ",
	|	");
	
	Возврат ПоляЗапроса;
	
КонецФункции

Функция УсловияЗапросаПоиска(Знач ПоляПоиска)
	
	Строки = Новый Массив;
	
	Для каждого Поле Из ПоляПоиска Цикл
		
		Если Поле = "Комментарий" Тогда // исключение, поиск по Комментарию
			Строки.Добавить(СтрШаблон("ВЫРАЗИТЬ(Таблица.%1 КАК СТРОКА(1024)) = РеквизитыПоиска.%1", Поле));
		Иначе
			Строки.Добавить(СтрШаблон("Таблица.%1 = РеквизитыПоиска.%1", Поле));
		КонецЕсли;
		
	КонецЦикла;
	
	УсловияЗапроса = СтрСоединить(Строки, "
	|			И ");
	
	Если УсловияЗапроса = "" Тогда
		УсловияЗапроса = "ИСТИНА";
	КонецЕсли;
	
	Возврат УсловияЗапроса;
	
КонецФункции

#КонецОбласти

Функция ПараметрыПоиска(СтрокаДанных, Знач ПараметрыОбъекта)
	
	ПараметрыПоиска = Новый Структура;
	
	Для каждого Поле Из ПараметрыОбъекта.ВсеПоляПоиска Цикл
		ПараметрыПоиска.Вставить(Поле, СтрокаДанных["Объект_" + Поле]);
	КонецЦикла;
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Функция ПараметрыОтбораТаблицыДанных(Знач ПараметрыПоиска, Знач ПараметрыОбъекта)
	
	Результат = Новый Структура;
	
	Для каждого Поле Из ПараметрыОбъекта.ВсеПоляПоиска Цикл
		Результат.Вставить("Объект_" + Поле, ПараметрыПоиска[Поле]);
	КонецЦикла;
	
	Результат.Вставить("Отказ", Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеПоиска(Знач ПараметрыПоиска, Знач ПараметрыОбъекта)
	
	Строки = Новый Массив;
	
	Для каждого Поле Из ПараметрыОбъекта.ПоляПоиска Цикл
		
		ПредставлениеПоля = СтрШаблон(НСтр("ru = '%1 = ""%2""'"),
			ПараметрыОбъекта.РеквизитыОбъекта[Поле].Представление,
			Строка(ПараметрыПоиска[Поле]));
		
		Строки.Добавить(ПредставлениеПоля);
		
	КонецЦикла;
	
	Для каждого Поле Из ПараметрыОбъекта.ДопПоляПоиска Цикл
		
		ПредставлениеПоля = СтрШаблон(НСтр("ru = '%1 = ""%2""'"),
			ПараметрыОбъекта.ДопРеквизитыОбъекта[Поле].Представление,
			Строка(ПараметрыПоиска[Поле]));
		
		Строки.Добавить(ПредставлениеПоля);
		
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, ", ");
	
КонецФункции

Функция ТаблицаПоиска(ТаблицаДанных, Знач ПараметрыОбъекта)
	
	ПоляДанных = Новый Массив;
	
	Для каждого Поле Из ПараметрыОбъекта.ВсеПоляПоиска Цикл
		ПоляДанных.Добавить("Объект_" + Поле);
	КонецЦикла;
	
	ИменаПолейДанных = СтрСоединить(ПоляДанных, ",");
	
	ТаблицаПоиска = ТаблицаДанных.Скопировать(Новый Структура("Отказ", Ложь), ИменаПолейДанных);
	
	Для каждого Колонка Из ТаблицаПоиска.Колонки Цикл
		Колонка.Имя = СтрЗаменить(Колонка.Имя, "Объект_", "");
	КонецЦикла;
	
	ТаблицаПоиска.Свернуть(ПараметрыОбъекта.ИменаВсехПолейПоиска);
	ТаблицаПоиска.Индексы.Добавить(ПараметрыОбъекта.ИменаВсехПолейПоиска);
	
	Возврат ТаблицаПоиска;
	
КонецФункции

// Возвращает таблицу ссылок, найденных по параметрам поиска.
//
// Параметры:
//  ПараметрыПоиска - Структура - значения полей поиска.
//  ПараметрыОбъекта - Структура - параметры сопоставляемого объекта.
//
// Возвращаемое значение:
//  ТаблицаЗначений - найденные ссылки.
//
Функция ТаблицаСсылок(Знач ПараметрыПоиска, Знач ПараметрыОбъекта) Экспорт
	
	Запрос = Новый Запрос(ПараметрыОбъекта.ТекстЗапросаПоиска);
	
	Для каждого КлючИЗначение Из ПараметрыПоиска Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Если ПараметрыОбъекта.ДопПоляПоиска.Количество() = 0 Тогда
		ТаблицаСсылок = Запрос.Выполнить().Выгрузить();
	Иначе
		
		Запрос.УстановитьПараметр("СвойстваПоиска", ПараметрыОбъекта.СвойстваПоиска);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		ВГраница = РезультатЗапроса.ВГраница();
		
		ТаблицаСсылок = РезультатЗапроса[ВГраница - 1].Выгрузить();
		ВыборкаСсылка = РезультатЗапроса[ВГраница].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ИменаКолонок = "Ссылка," + ПараметрыОбъекта.ИменаДопПолейПоиска;
		
		ТаблицаСвойств = ТаблицаСсылок.СкопироватьКолонки(ИменаКолонок);
		ТаблицаСвойств.Индексы.Добавить(ИменаКолонок);
		
		Пока ВыборкаСсылка.Следующий() Цикл
			
			НоваяСтрока = ТаблицаСвойств.Добавить();
			НоваяСтрока.Ссылка = ВыборкаСсылка.Ссылка;
			
			ВыборкаСвойство = ВыборкаСсылка.Выбрать();
			Пока ВыборкаСвойство.Следующий() Цикл
				НоваяСтрока["Доп_" + ВыборкаСвойство.Имя] = ВыборкаСвойство.Значение;
			КонецЦикла;
			
		КонецЦикла;
		
		//
		
		УдаляемыеСтроки = Новый Массив;
		ПараметрыОтбора = Новый Структура(ИменаКолонок);
		
		Для каждого СтрокаСсылок Из ТаблицаСсылок Цикл
			
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаСсылок);
			
			НайденныеСтроки = ТаблицаСвойств.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				УдаляемыеСтроки.Добавить(СтрокаСсылок);
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого СтрокаСсылок Из УдаляемыеСтроки Цикл
			ТаблицаСсылок.Удалить(СтрокаСсылок);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаСсылок;
	
КонецФункции

// Создаёт или изменяет объект по строке данных в соответствии с параметрами объекта.
//
// Параметры:
//  Ссылка - Произвольный, Неопределено - ссылка на изменяемый объект или Неопределено для создания нового.
//  ПараметрыОбъекта - Структура - параметры сопоставляемого объекта.
//  СтрокаДанных - СтрокаТаблицыЗначений - строка данных для сопоставления.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//
// Возвращаемое значение:
//  Структура, Неопределено - данные созданного или изменённого объекта:
//   * Ссылка - Произвольный, Неопределено - ссылка на объект;
//   * Объект - Произвольный, Неопределено - объект для записи;
//   * СвязанныеОбъекты - Массив из Произвольный - связанные объекты.
//
Функция СоздатьИзменитьОбъект(Знач Ссылка, Знач ПараметрыОбъекта, Знач СтрокаДанных, ПараметрыСопоставления)
	
	Если Ссылка = Неопределено Тогда
		
		Объект = ?(СтрНайти(ПараметрыОбъекта.ПолноеИмяОбъекта, "Документ") = 1,
			ПараметрыОбъекта.МенеджерОбъекта.СоздатьДокумент(),
			?(ПараметрыОбъекта.СоздаватьГруппы = Истина,
			ПараметрыОбъекта.МенеджерОбъекта.СоздатьГруппу(),ПараметрыОбъекта.МенеджерОбъекта.СоздатьЭлемент()));
		
		//Ссылка = ПараметрыОбъекта.МенеджерОбъекта.ПолучитьСсылку();
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаДанных, "ПредставлениеСсылкиОбъекта") 
			И ЗначениеЗаполнено(СтрокаДанных.ПредставлениеСсылкиОбъекта) Тогда 
			Ссылка = ПараметрыОбъекта.МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаДанных.ПредставлениеСсылкиОбъекта)); 
		Иначе 
			Ссылка = ПараметрыОбъекта.МенеджерОбъекта.ПолучитьСсылку();
		КонецЕсли;
		Объект.УстановитьСсылкуНового(Ссылка);
		
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	//
	
	Отказ = Ложь;
	
	ВыполнитьКодОбработчикаПередОбработкойВПопытке(
		Объект, ПараметрыОбъекта, ПараметрыСопоставления, Отказ);
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Заполнение реквизитов номенклатуры по виду номенклатуры.
	Если ТипЗнч(Объект) = Тип("СправочникОбъект.Номенклатура")
		И ПараметрыОбъекта.ИменаРеквизитов.Найти("ВидНоменклатуры") <> Неопределено Тогда
		
		ИмяРеквизита = "ВидНоменклатуры";
		Объект[ИмяРеквизита] = СтрокаДанных.Объект_ВидНоменклатуры;
		Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Объект);
		
	КонецЕсли;
	
	// Заполнение реквизитов.
	Для каждого Имя Из ПараметрыОбъекта.ИменаРеквизитов Цикл
		Если Имя = "Ссылка" Тогда 
			Продолжить;
		КонецЕсли;
		Объект[Имя] = СтрокаДанных["Объект_" + Имя];
	КонецЦикла;
	
	// Заполнение доп. реквизитов.
	Для каждого ДопРеквизит Из ПараметрыОбъекта.ДопРеквизитыОбъекта Цикл
		
		// Удаление текущего значения.
		ПараметрыОтбора = Новый Структура("Свойство", ДопРеквизит.Значение.Свойство);
		
		НайденныеСтроки = Объект["ДополнительныеРеквизиты"].НайтиСтроки(ПараметрыОтбора);
		Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
			Объект["ДополнительныеРеквизиты"].Удалить(СтрокаТаблицы);
		КонецЦикла;
		
		// Добавление нового значения.
		Значение = СтрокаДанных["Объект_" + ДопРеквизит.Ключ];
		
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДопРеквизит.Значение.ТипЗначения.Типы().Количество() = 1
			И (Не ЗначениеЗаполнено(Значение) Или Значение = Ложь) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект["ДополнительныеРеквизиты"].Добавить();
		НоваяСтрока.Свойство = ДопРеквизит.Значение.Свойство;
		НоваяСтрока.Значение = Значение;
		
	КонецЦикла;
	
	ДанныеОбъекта = ДанныеОбъекта();
	ДанныеОбъекта.Ссылка = Ссылка;
	ДанныеОбъекта.Объект = Объект;
	
	Возврат ДанныеОбъекта;
	
КонецФункции

// Записывает объект и связанные с ним данные в транзакции.
//
// Параметры:
//  ДанныеОбъекта - Структура - данные записываемого объекта.
//  ПараметрыОбъекта - Структура - параметры сопоставляемого объекта.
//  ДанныеИсточника - Структура - данные строки источника.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//
// Возвращаемое значение:
//  Булево - Истина, если объект успешно записан.
//
Функция ЗаписатьОбъект(ДанныеОбъекта, Знач ПараметрыОбъекта, Знач ДанныеИсточника, ПараметрыСопоставления) Экспорт
	
	Отказ = Ложь;
	
	НачатьТранзакцию();
	Попытка
		
		// Обработчик ПередЗаписью.
		ВыполнитьКодОбработчикаПередЗаписьюВПопытке(
			ДанныеОбъекта.Объект, ПараметрыОбъекта, ДанныеИсточника, ПараметрыСопоставления, Отказ);
		
		Если Не Отказ Тогда
			
			Если ПараметрыСопоставления.РежимРазработчика Тогда
				ДанныеОбъекта.Объект.ОбменДанными.Загрузка = Истина;
			КонецЕсли;
			
			ДанныеОбъекта.Объект.Записать();
			
			Если ДанныеОбъекта.СвязанныеОбъекты.Количество() <> 0 Тогда
				
				УстановитьПривилегированныйРежим(Истина);
				
				Для каждого СвязанныйОбъект Из ДанныеОбъекта.СвязанныеОбъекты Цикл
					СвязанныйОбъект.Записать();
				КонецЦикла;
				
				УстановитьПривилегированныйРежим(Ложь);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ДобавитьСообщенияВОписаниеОшибок(ПараметрыСопоставления);
		
		ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
			СтрШаблон(НСтр("ru = 'Ошибка записи объекта ""%1"":
			|%2'"),
			ПараметрыОбъекта.ПредставлениеОбъекта,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			,
			Отказ);
		
	КонецПопытки;
	
	// Обработчик ПослеЗаписи.
	ВыполнитьКодОбработчикаПослеЗаписиВПопытке(
		ДанныеОбъекта.Объект, ПараметрыОбъекта, ДанныеИсточника, ПараметрыСопоставления, Отказ);
	
	Возврат Не Отказ;
	
КонецФункции

// Возвращает структуру данных объекта для сопоставления.
//
// Возвращаемое значение:
//  Структура - данные объекта, содержащие ссылку, объект для записи и связанные объекты:
//   * Ссылка - Произвольный, Неопределено - ссылка на найденный или созданный объект;
//   * Объект - Произвольный, Неопределено - объект для записи;
//   * СвязанныеОбъекты - Массив из Произвольный - связанные объекты.
//
Функция ДанныеОбъекта() Экспорт
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Ссылка",          Неопределено);
	ДанныеОбъекта.Вставить("Объект",          Неопределено);
	ДанныеОбъекта.Вставить("СвязанныеОбъекты", Новый Массив);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

