#Область ЗагрузкаОбъектов

// Находит или создаёт объект по строке данных в соответствии с параметрами объекта.
//
// Параметры:
//  СтрокаДанных - СтрокаТаблицыЗначений - строка данных для сопоставления.
//  ПараметрыОбъекта - Структура - параметры сопоставляемого объекта.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//
// Возвращаемое значение:
//  Структура, Неопределено - данные найденного или созданного объекта:
//   * Ссылка - Произвольный, Неопределено - ссылка на найденный или созданный объект;
//   * Объект - Произвольный, Неопределено - объект для записи;
//   * СвязанныеОбъекты - Массив из Произвольный - связанные объекты.
//
Функция НайтиСоздатьОбъект(СтрокаДанных, Знач ПараметрыОбъекта, ПараметрыСопоставления) Экспорт
	
	Если ПараметрыОбъекта.ВсеПоляПоиска.Количество() = 0 Тогда
		
		ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
			НСтр("ru = 'Не указаны поля поиска для сопоставляемых объектов'"));
		Возврат Неопределено;
		
	КонецЕсли;
	
	ПараметрыПоиска = ПараметрыПоиска(СтрокаДанных, ПараметрыОбъекта);
	
	ТаблицаСсылок    = ТаблицаСсылок(ПараметрыПоиска, ПараметрыОбъекта);
	КоличествоСсылок = ТаблицаСсылок.Количество();
	
	Если КоличествоСсылок = 0 Тогда
		
		Если ПараметрыСопоставления.СоздаватьНовыеОбъекты Тогда
			Возврат СоздатьИзменитьОбъект(Неопределено, ПараметрыОбъекта, СтрокаДанных, ПараметрыСопоставления);
		Иначе
			
			ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
				СтрШаблон(НСтр("ru = 'Не найден объект ""%1"" по полям поиска: %2'"),
					ПараметрыОбъекта.ПредставлениеОбъекта,
					ПредставлениеПоиска(ПараметрыПоиска, ПараметрыОбъекта)));
			
		КонецЕсли;
		
	ИначеЕсли КоличествоСсылок = 1 Тогда
		
		Если ПараметрыСопоставления.ОбновлятьСуществующиеОбъекты Тогда
			Возврат СоздатьИзменитьОбъект(ТаблицаСсылок[0].Ссылка, ПараметрыОбъекта, СтрокаДанных, ПараметрыСопоставления);
		КонецЕсли;
		
	ИначеЕсли КоличествоСсылок > 1 Тогда
		
		ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
			СтрШаблон(НСтр("ru = 'Найдено несколько объектов ""%1"" по полям поиска: %2'"),
				ПараметрыОбъекта.ПредставлениеОбъекта,
				ПредставлениеПоиска(ПараметрыПоиска, ПараметрыОбъекта)));
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗагрузитьДанныеОбъекта(Знач Ссылка, Знач ПараметрыЗагрузки, Знач ПараметрыОтбора, ОписаниеОшибок)
	
	ПараметрыИсточника = ПараметрыИсточника(ПараметрыЗагрузки.ИсточникДанных);
	
	Если ПараметрыИсточника.ТипИсточника = Перечисления.ТБ_ТипыИсточниковДанных.COM1C Тогда
		
		Соединение = ТБ_СопоставлениеОбъектовПовтИсп.COMСоединение(ПараметрыИсточника.НастройкаПодключения);
		Если Соединение = Неопределено Тогда
			
			ТекстСообщения = НСтр("ru = 'При подключении к источнику возникли ошибки (см. Журнал регистрации).'");
			ВызватьИсключение ТекстСообщения;
			
		КонецЕсли;
		
	Иначе
		Соединение = Неопределено;
	КонецЕсли;
	
	//
	
	СвойстваИсточника = ТаблицаСвойствИсточникаДанных();
	ЗаполнитьСвойстваИсточникаДанныхПоПравилу(СвойстваИсточника, ПараметрыЗагрузки.ПравилоСопоставления);
	
	ТаблицаИсточника = ТаблицаИсточника(СвойстваИсточника);
	ЗагрузитьИзВнешнегоИсточника(ТаблицаИсточника, ПараметрыЗагрузки.ИсточникДанных, СвойстваИсточника,
		ПараметрыОтбора, Ложь, Соединение);
	
	ТаблицаИсточника = ТаблицаИсточникаСОтборами(ТаблицаИсточника, СвойстваИсточника, ПараметрыЗагрузки.ПравилоСопоставления);
	
	КоличествоЗаписей = ТаблицаИсточника.Количество();
	Если КоличествоЗаписей = 0 Тогда
		
		ДобавитьОписаниеОшибки(ОписаниеОшибок, НСтр("ru = 'Объект не найден в источнике'"));
		Возврат;
		
	ИначеЕсли КоличествоЗаписей > 1 Тогда
		
		ДобавитьОписаниеОшибки(ОписаниеОшибок, НСтр("ru = 'Объекту соответствует несколько объектов в источнике'"));
		Возврат;
		
	КонецЕсли;
	
	//
	
	ТаблицаСоответствия = ТаблицаСоответствия(СвойстваИсточника);
	ЗаполнитьТаблицуСоответствия(ТаблицаСоответствия, ТаблицаИсточника, СвойстваИсточника, ПараметрыЗагрузки);
	
	ПараметрыСопоставления = ПараметрыСопоставления(ПараметрыЗагрузки.ПравилоСопоставления);
	ПараметрыСопоставления.СоздаватьНовыеЗначенияСвойств = Ложь;
	ПараметрыСопоставления.СоздаватьНовыеОбъекты         = Ложь;
	ПараметрыСопоставления.ОбновлятьСуществующиеОбъекты  = Истина;
	ПараметрыСопоставления.РежимРазработчика             = Ложь;
	
	ТаблицаДанных = ТаблицаДанныхСоЗначениямиПолей(ТаблицаСоответствия, ПараметрыСопоставления, СвойстваИсточника);
	СтрокаДанных  = ТаблицаДанных[0];
	
	ПараметрыОбъекта = ПараметрыОбъекта(ПараметрыЗагрузки.ПравилоСопоставления, ПараметрыСопоставления);
	
	//
	
	ДанныеОбъекта = СоздатьИзменитьОбъект(Ссылка, ПараметрыОбъекта, СтрокаДанных, ПараметрыСопоставления);
	
	Если ДанныеОбъекта = Неопределено Тогда
		
		ДобавитьОписаниеОшибки(ОписаниеОшибок, НСтр("ru = 'Ошибка обновления объекта из источника'"));
		Возврат;
		
	КонецЕсли;
	
	//
	
	СтрокаСоответствия = ТаблицаСоответствия[0];
	
	СоответствияОбъектов = РегистрыСведений.ТБ_СоответствияОбъектов.СоздатьНаборЗаписей();
	СоответствияОбъектов.Отбор.Идентификатор.Установить(СтрокаСоответствия.Идентификатор);
	СоответствияОбъектов.Отбор.ИмяОбъекта.Установить(СтрокаСоответствия.ИмяОбъекта);
	
	НоваяЗапись = СоответствияОбъектов.Добавить();
	НоваяЗапись.Идентификатор        = СтрокаСоответствия.Идентификатор;
	НоваяЗапись.ИмяОбъекта           = СтрокаСоответствия.ИмяОбъекта;
	НоваяЗапись.Объект               = ДанныеОбъекта.Ссылка;
	НоваяЗапись.ИсточникДанных       = СтрокаСоответствия.ИсточникДанных;
	НоваяЗапись.Представление        = СтрокаСоответствия.Представление;
	НоваяЗапись.ДанныеИсточника      = СтрокаСоответствия.ДанныеИсточника;
	НоваяЗапись.ПравилоСопоставления = СтрокаСоответствия.ПравилоСопоставления;
	
	ДанныеОбъекта.СвязанныеОбъекты.Добавить(СоответствияОбъектов);
	
	// Загрузка табличных частей.
	ПравилаТабличныхЧастей = Новый Массив;
	Для каждого СтрокаТаблицы Из ПараметрыЗагрузки.ТабличныеЧасти Цикл
		ПравилаТабличныхЧастей.Добавить(СтрокаТаблицы.ПравилоСопоставления);
	КонецЦикла;
	
	СвойстваПоПравилам = Новый Соответствие;
	
	Для каждого ПравилоТабличнойЧасти Из ПравилаТабличныхЧастей Цикл
		СвойстваПоПравилам.Вставить(ПравилоТабличнойЧасти, ТаблицаСвойствИсточникаДанных());
	КонецЦикла;
	
	Если ПравилаТабличныхЧастей.Количество() > 0 Тогда
		
		ЗапросСвойств = Новый Запрос(
		"ВЫБРАТЬ
		|	СвойстваИсточника.Ссылка КАК ПравилоСопоставления,
		|	Свойства.Имя КАК Имя,
		|	Свойства.Представление КАК Представление,
		|	Свойства.Тип КАК Тип,
		|	СвойстваИсточника.ВключатьВИдентификатор КАК ВключатьВИдентификатор,
		|	СвойстваИсточника.ВключатьВПредставление КАК ВключатьВПредставление
		|ИЗ
		|	Справочник.ТБ_ПравилаСопоставления.СвойстваИсточника КАК СвойстваИсточника
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТБ_ИсточникиДанных.Свойства КАК Свойства
		|		ПО СвойстваИсточника.Ссылка.ИсточникДанных = Свойства.Ссылка
		|			И СвойстваИсточника.Имя = Свойства.Имя
		|ГДЕ
		|	СвойстваИсточника.Ссылка В (&Правила)
		|	И СвойстваИсточника.Пометка");
		
		ЗапросСвойств.УстановитьПараметр("Правила", ПравилаТабличныхЧастей);
		
		ВыборкаСвойств = ЗапросСвойств.Выполнить().Выбрать();
		Пока ВыборкаСвойств.Следующий() Цикл
			
			ТаблицаСвойств = СвойстваПоПравилам.Получить(ВыборкаСвойств.ПравилоСопоставления);
			Если ТаблицаСвойств = Неопределено Тогда
				ТаблицаСвойств = ТаблицаСвойствИсточникаДанных();
				СвойстваПоПравилам.Вставить(ВыборкаСвойств.ПравилоСопоставления, ТаблицаСвойств);
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ТаблицаСвойств.Добавить(), ВыборкаСвойств);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из ПараметрыЗагрузки.ТабличныеЧасти Цикл
		
		ПараметрыОтбора = ПараметрыОтбораИдентификатора(СтрокаТаблицы.ПравилоСопоставления, СтрокаДанных.ДанныеИсточника);
		ТБ_ЗагрузкаОбъектов.ЗагрузитьДанныеТабличнойЧастиПоПравилу(ДанныеОбъекта, СтрокаТаблицы.ПравилоСопоставления,
			ПараметрыОтбора, ОписаниеОшибок, Соединение, СвойстваПоПравилам.Получить(СтрокаТаблицы.ПравилоСопоставления));
		
	КонецЦикла;
	
	//
	
	Если Не ЗаписатьОбъект(ДанныеОбъекта, ПараметрыОбъекта, СтрокаДанных.ДанныеИсточника, ПараметрыСопоставления) Тогда
		ДобавитьОписаниеОшибки(ОписаниеОшибок, НСтр("ru = 'Ошибка обновления объекта из источника'"));
	КонецЕсли;
	
КонецПроцедуры

// Загружает данные табличной части объекта из внешнего источника.
//
// Параметры:
//  ДанныеОбъекта - Структура - данные объекта, для которого загружается табличная часть.
//  ПравилоСопоставления - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//  ПараметрыОтбора - Структура, Соответствие из КлючИЗначение - параметры отбора данных.
//  ОписаниеОшибок - Массив из Структура - описание возникших ошибок.
//  Соединение - Произвольный, Неопределено - установленное соединение с внешним источником.
//  СвойстваИсточникаПредзагруженные - ТаблицаЗначений, Неопределено - заранее загруженные свойства источника.
//
Процедура ЗагрузитьДанныеТабличнойЧасти(ДанныеОбъекта, Знач ПравилоСопоставления, Знач ПараметрыОтбора, ОписаниеОшибок, Соединение = Неопределено,
	Знач СвойстваИсточникаПредзагруженные = Неопределено) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПравилоСопоставления, "ИсточникДанных,ИмяТабличнойЧасти");
	
	ИсточникДанных = ЗначенияРеквизитов.ИсточникДанных;
	
	//
	
	СвойстваИсточника = ТаблицаСвойствИсточникаДанных();
	ЗаполнитьСвойстваИсточникаДанныхПоПравилу(СвойстваИсточника, ПравилоСопоставления, Ложь, СвойстваИсточникаПредзагруженные);
	
	ТаблицаИсточника = ТаблицаИсточника(СвойстваИсточника);
	ЗагрузитьИзВнешнегоИсточника(ТаблицаИсточника, ИсточникДанных, СвойстваИсточника, ПараметрыОтбора, Ложь, Соединение);
	
	//
	
	ТаблицаИсточника = ТаблицаИсточникаСОтборами(ТаблицаИсточника, СвойстваИсточника, ПравилоСопоставления);
	ТаблицаИсточника.Колонки.Добавить("Идентификатор",       ОбщегоНазначения.ОписаниеТипаСтрока(250));
	ТаблицаИсточника.Колонки.Добавить("ИдентификаторСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	
	ИдентификаторСтроки = 0;
	
	Для каждого СтрокаТаблицы Из ТаблицаИсточника Цикл
		
		СтрокаТаблицы.Идентификатор = ИдентификаторИсточника(СтрокаТаблицы, СвойстваИсточника);
		СтрокаТаблицы.ИдентификаторСтроки = ИдентификаторСтроки;
		
		ИдентификаторСтроки = ИдентификаторСтроки + 1;
		
	КонецЦикла;
	
	//
	
	ЗагруженныеДанные = РегистрыСведений.ТБ_ЗагруженныеДанныеИсточника.СоздатьНаборЗаписей();
	ЗагруженныеДанные.Отбор.ИсточникДанных.Установить(ИсточникДанных);
	ЗагруженныеДанные.Отбор.ПравилоСопоставления.Установить(ПравилоСопоставления);
	ЗагруженныеДанные.Отбор.Объект.Установить(ДанныеОбъекта.Ссылка);
	
	НомерЗаписи  = 1;
	ДатаЗагрузки = ТекущаяДатаСеанса();
	
	//
	
	ПараметрыСопоставления = ПараметрыСопоставления(ПравилоСопоставления);
	ПараметрыСопоставления.ОчищатьТабличнуюЧасть = Истина;
	ПараметрыСопоставления.РежимРазработчика     = Ложь;
	ПараметрыСопоставления.ОписаниеОшибок        = ОписаниеОшибок;
	
	ТаблицаДанных = ТаблицаДанныхСоЗначениямиПолей(ТаблицаИсточника, ПараметрыСопоставления, СвойстваИсточника);
	
	ТабличнаяЧасть = ДанныеОбъекта.Объект[ЗначенияРеквизитов.ИмяТабличнойЧасти];
	
	Если ПараметрыСопоставления.ОчищатьТабличнуюЧасть Тогда
		ТабличнаяЧасть.Очистить();
	КонецЕсли;
	
	Для каждого СтрокаДанных Из ТаблицаДанных Цикл
		
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		
		Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаРеквизитов Цикл
			
			Если СтрокаТаблицы.Имя = "Ссылка" Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока[СтрокаТаблицы.Имя] = СтрокаДанных[СтрокаТаблицы.ПолноеИмя];
			
		КонецЦикла;
		
		//
		
		НоваяЗапись = ЗагруженныеДанные.Добавить();
		НоваяЗапись.ИсточникДанных       = ИсточникДанных;
		НоваяЗапись.ПравилоСопоставления = ПравилоСопоставления;
		НоваяЗапись.Объект               = ДанныеОбъекта.Ссылка;
		НоваяЗапись.НомерЗаписи          = НомерЗаписи;
		НоваяЗапись.ДанныеИсточника      = СтрокаJSON(СтрокаДанных.ДанныеИсточника);
		НоваяЗапись.ДатаЗагрузки         = ДатаЗагрузки;
		
		НомерЗаписи = НомерЗаписи + 1;
		
	КонецЦикла;
	
	//
	
	ДанныеОбъекта.СвязанныеОбъекты.Добавить(ЗагруженныеДанные);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуСоответствия(ТаблицаСоответствия, Знач ТаблицаИсточника, Знач СвойстваИсточника, ПараметрыСопоставления)
	
	ИдентификаторСтроки = 0;
	
	Для каждого СтрокаТаблицы Из ТаблицаИсточника Цикл
		
		СтрокаСоответствия = ТаблицаСоответствия.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСоответствия, СтрокаТаблицы);
		
		Идентификатор   = ИдентификаторИсточника(СтрокаСоответствия, СвойстваИсточника);
		Представление   = ПредставлениеИсточника(СтрокаСоответствия, СвойстваИсточника);
		СтруктураДанных = СтруктураДанныхИсточника(СтрокаСоответствия, СвойстваИсточника);
		
		СтрокаСоответствия.Идентификатор        = Идентификатор;
		СтрокаСоответствия.ИмяОбъекта           = ПараметрыСопоставления.ИмяОбъекта;
		СтрокаСоответствия.Объект               = Неопределено;
		СтрокаСоответствия["ИсточникДанных"]       = ПараметрыСопоставления.ИсточникДанных;
		СтрокаСоответствия.Представление        = Представление;
		СтрокаСоответствия.ДанныеИсточника      = СтрокаJSON(СтруктураДанных);
		СтрокаСоответствия["ПравилоСопоставления"] = ПараметрыСопоставления.ПравилоСопоставления;
		СтрокаСоответствия.ИдентификаторСтроки  = ИдентификаторСтроки;
		СтрокаСоответствия.Сопоставлено         = Ложь;
		
		ИдентификаторСтроки = ИдентификаторСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбщегоНазначения

Функция СпецСимволы()
	
	Диапазоны = Новый Массив;
	Диапазоны.Добавить(Новый Структура("Мин, Макс", 0, 32));
	Диапазоны.Добавить(Новый Структура("Мин, Макс", 127, 191));
	
	СпецСимволы = " .,+-/*?=<>()%!@#$%&*""№:;{}[]?()\|/`~'^_";
	
	Для каждого Диапазон Из Диапазоны Цикл
		
		Для КодСимвола = Диапазон.Мин По Диапазон.Макс Цикл
			СпецСимволы = СпецСимволы + Символ(КодСимвола);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СпецСимволы;
	
КонецФункции

#КонецОбласти

#Область ОбменСЗагрузкойОбъектов

// Возвращает таблицу отклонений загруженных данных объекта от источника.
//
// Параметры:
//  ПравилоСопоставления - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//  Объект - СправочникСсылка, ДокументСсылка - объект.
//  СтруктураДанных - Структура, Неопределено - данные источника.
//  СтрокиЗагруженныхДанных - Массив из Произвольный, Неопределено - заранее прочитанные данные загруженных строк регистра.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица отклонений.
//
Функция ТаблицаОтклоненийОбъекта(Знач ПравилоСопоставления, Знач Объект, Знач СтруктураДанных = Неопределено,
	Знач СтрокиЗагруженныхДанных = Неопределено) Экспорт
	
	Возврат ТБ_ЗагрузкаОбъектов.ТаблицаОтклонений(ПравилоСопоставления, Объект, СтруктураДанных, СтрокиЗагруженныхДанных);
	
КонецФункции

#КонецОбласти

#КонецОбласти
