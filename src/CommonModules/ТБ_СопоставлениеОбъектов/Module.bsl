
#Область ПрограммныйИнтерфейс

#Область СпискиВыбора

// Заполняет список выбора полными именами типов объектов, доступных для сопоставления.
//
// Параметры:
//  СписокВыбора - СписокЗначений из Строка - список выбора, который требуется заполнить.
//
Процедура ЗаполнитьСписокВыбораОбъекта(СписокВыбора) Экспорт
	
	СписокВыбора.Очистить();
	
	Для каждого Тип Из Метаданные.РегистрыСведений.ТБ_СоответствияОбъектов.Ресурсы.Объект.Тип.Типы() Цикл
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Если ОбъектМетаданных <> Неопределено Тогда
			СписокВыбора.Добавить(ОбъектМетаданных.ПолноеИмя(), ОбъектМетаданных.Представление());
		КонецЕсли;
		
	КонецЦикла;
	
	СписокВыбора.СортироватьПоПредставлению();
	
КонецПроцедуры

// Заполняет список выбора именами табличных частей указанного объекта метаданных.
//
// Параметры:
//  СписокВыбора - СписокЗначений из Строка - список выбора, который требуется заполнить.
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных.
//
Процедура ЗаполнитьСписокВыбораТабличнойЧасти(СписокВыбора, Знач ПолноеИмяОбъекта) Экспорт
	
	СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(ПолноеИмяОбъекта) Тогда
		
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
		Если ОбъектМетаданных <> Неопределено Тогда
			
			Для каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
				
				Если ТабличнаяЧасть.Имя = "ДополнительныеРеквизиты" Тогда
					Продолжить;
				КонецЕсли;
				
				СписокВыбора.Добавить(ТабличнаяЧасть.Имя, ТабличнаяЧасть.Представление());
				
			КонецЦикла;
			
		КонецЕсли;
		
		СписокВыбора.СортироватьПоПредставлению();
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет список выбора формами списка, соответствующими указанному объекту метаданных.
//
// Параметры:
//  СписокВыбора - СписокЗначений из Строка - список выбора, который требуется заполнить.
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных.
//
Процедура ЗаполнитьСписокВыбораФормыСписка(СписокВыбора, Знач ПолноеИмяОбъекта) Экспорт
	
	СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(ПолноеИмяОбъекта) Тогда
		
		Если ПолноеИмяОбъекта = "Документ.ВозвратТоваровПоставщику" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Обработка.ЖурналДокументовЗакупки.Форма.СписокДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ВозвратТоваровОтКлиента" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Обработка.ЖурналДокументовПродажи.Форма.СписокДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ЗаказКлиента" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Документ.ЗаказКлиента.Форма.ФормаСпискаДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ЗаказПоставщику" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Документ.ЗаказПоставщику.Форма.ФормаСпискаДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ЗаявкаНаВозвратТоваровОтКлиента" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Документ.ЗаявкаНаВозвратТоваровОтКлиента.Форма.ФормаСпискаДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.КорректировкаРеализации" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Обработка.ЖурналДокументовПродажи.Форма.СписокДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ОперацияПоПлатежнойКарте" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Документ.ОперацияПоПлатежнойКарте.Форма.ФормаСпискаДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ОтчетКомиссионера" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Обработка.ЖурналДокументовОтчетыКомиссионеров.Форма.СписокДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ОтчетКомитенту" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Обработка.ЖурналДокументовОтчетыКомитентам.Форма.СписокДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ОтчетОРозничныхПродажах" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Документ.ОтчетОРозничныхПродажах.Форма.ФормаСписка");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ПеремещениеТоваров" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Обработка.ЖурналДокументовВнутреннегоТовародвижения.Форма.СписокДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ПоступлениеБезналичныхДенежныхСредств" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Обработка.ЖурналДокументовБезналичныеПлатежи.Форма.ФормаСписка");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ПриобретениеТоваровУслуг" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Обработка.ЖурналДокументовЗакупки.Форма.СписокДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ПриходныйКассовыйОрдер" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Документ.ПриходныйКассовыйОрдер.Форма.ФормаСпискаДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ПриходныйОрдерНаТовары" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "ЖурналДокументов.СкладскиеОрдера.Форма.ФормаСписка");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.РасходныйКассовыйОрдер" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Документ.РасходныйКассовыйОрдер.Форма.ФормаСпискаДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.РасходныйОрдерНаТовары" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "ЖурналДокументов.СкладскиеОрдера.Форма.ФормаСписка");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.РеализацияТоваровУслуг" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Обработка.ЖурналДокументовПродажи.Форма.СписокДокументов");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.СписаниеБезналичныхДенежныхСредств" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Обработка.ЖурналДокументовБезналичныеПлатежи.Форма.ФормаСписка");
			
		ИначеЕсли ПолноеИмяОбъекта = "Документ.ТБ_Груз" Тогда
			
			ДобавитьФормуСписка(СписокВыбора, "Документ.ТБ_Груз.Форма.ФормаСписка");
			
		КонецЕсли;
		
		СписокВыбора.СортироватьПоПредставлению();
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет список выбора элемента формы представлением указанного объекта метаданных.
//
// Параметры:
//  ОбъектИмяОбъекта - Строка - полное имя объекта метаданных.
//  СписокВыбораЭлемента - СписокЗначений из Строка - список выбора, который требуется заполнить.
//
Процедура ЗаполнитьСписокВыбораИмяОбъекта(ОбъектИмяОбъекта, СписокВыбораЭлемента) Экспорт
	
	НайденныйОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ОбъектИмяОбъекта);
	Если НайденныйОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбораЭлемента.Очистить();
	
	СписокВыбораЭлемента.Добавить(ОбъектИмяОбъекта, НайденныйОбъектМетаданных.Синоним);
	
КонецПроцедуры

#КонецОбласти

#Область СвойстваИсточника

// Возвращает таблицу значений с описанием свойств источника данных.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с колонками: Имя, Представление, Тип, ВключатьВИдентификатор, ВключатьВПредставление.
//
Функция ТаблицаСвойствИсточникаДанных() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Имя",                    Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Представление",          Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Тип",                    Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ВключатьВИдентификатор", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ВключатьВПредставление", Новый ОписаниеТипов("Булево"));
	
	Возврат Результат;
	
КонецФункции

// Заполняет таблицу свойств источника данных по указанному источнику данных.
//
// Параметры:
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//  ИсточникДанных - СправочникСсылка.ТБ_ИсточникиДанных - источник данных.
//  Видимость - Булево - признак видимости свойств.
//
Процедура ЗаполнитьСвойстваИсточникаДанных(СвойстваИсточника, Знач ИсточникДанных, Знач Видимость = Ложь) Экспорт
	
	СвойстваИсточника.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Свойства.Имя КАК Имя,
	|	Свойства.Представление КАК Представление,
	|	Свойства.Тип КАК Тип,
	|	&Видимость КАК Видимость
	|ИЗ
	|	Справочник.ТБ_ИсточникиДанных.Свойства КАК Свойства
	|ГДЕ
	|	Свойства.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка",    ИсточникДанных);
	Запрос.УстановитьПараметр("Видимость", Видимость);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СвойстваИсточника.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет таблицу свойств источника данных по указанному правилу сопоставления.
//
// Параметры:
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//  ПравилоСопоставления - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//  Видимость - Булево - признак видимости свойств.
//  СвойстваПредзагруженные - ТаблицаЗначений, Неопределено - заранее загруженные свойства источника данных.
//
Процедура ЗаполнитьСвойстваИсточникаДанныхПоПравилу(СвойстваИсточника, Знач ПравилоСопоставления, Знач Видимость = Ложь,
	Знач СвойстваПредзагруженные = Неопределено) Экспорт
	
	Если СвойстваПредзагруженные <> Неопределено Тогда
		СвойстваИсточника.Очистить();
		СвойстваИсточника.Загрузить(СвойстваПредзагруженные);
		Возврат;
	КонецЕсли;
	
	СвойстваИсточника.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Свойства.Имя КАК Имя,
	|	Свойства.Представление КАК Представление,
	|	Свойства.Тип КАК Тип,
	|	СвойстваИсточника.ВключатьВИдентификатор КАК ВключатьВИдентификатор,
	|	СвойстваИсточника.ВключатьВПредставление КАК ВключатьВПредставление,
	|	&Видимость КАК Видимость
	|ИЗ
	|	Справочник.ТБ_ПравилаСопоставления.СвойстваИсточника КАК СвойстваИсточника
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТБ_ИсточникиДанных.Свойства КАК Свойства
	|		ПО СвойстваИсточника.Ссылка.ИсточникДанных = Свойства.Ссылка
	|			И СвойстваИсточника.Имя = Свойства.Имя
	|ГДЕ
	|	СвойстваИсточника.Ссылка = &ПравилоСопоставления
	|	И СвойстваИсточника.Пометка");
	
	Запрос.УстановитьПараметр("ПравилоСопоставления", ПравилоСопоставления);
	Запрос.УстановитьПараметр("Видимость",            Видимость);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СвойстваИсточника.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет таблицу свойств источника данных по указанной настройке загрузки объектов.
//
// Параметры:
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//  НастройкаЗагрузки - СправочникСсылка.ТБ_НастройкиЗагрузкиОбъектов - настройка загрузки объектов.
//
Процедура ЗаполнитьСвойстваИсточникаДанныхПоНастройке(СвойстваИсточника, Знач НастройкаЗагрузки) Экспорт
	
	СвойстваИсточника.Очистить();
	
	ТаблицаСвойствИсточника = СвойстваИсточника.Выгрузить();
	
	ПравилоСопоставления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаЗагрузки, "ПравилоСопоставления");
	ЗаполнитьСвойстваИсточникаДанныхПоПравилу(ТаблицаСвойствИсточника, ПравилоСопоставления);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПоляСписка.Имя КАК Имя,
	|	ПоляСписка.Представление КАК Представление,
	|	ПоляСписка.Пометка КАК Видимость
	|ИЗ
	|	Справочник.ТБ_НастройкиЗагрузкиОбъектов.ПоляСписка КАК ПоляСписка
	|ГДЕ
	|	ПоляСписка.Ссылка = &НастройкаЗагрузки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоляСписка.НомерСтроки");
	
	Запрос.УстановитьПараметр("НастройкаЗагрузки", НастройкаЗагрузки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НайденныеСтроки = ТаблицаСвойствИсточника.НайтиСтроки(Новый Структура("Имя", Выборка.Имя));
		Если НайденныеСтроки.Количество() <> 0 Тогда
			
			НоваяСтрока = СвойстваИсточника.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ТаблицаИсточника

// Возвращает пустую таблицу значений с колонками, соответствующими свойствам источника данных.
//
// Параметры:
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с колонками по свойствам источника данных.
//
Функция ТаблицаИсточника(Знач СвойстваИсточника) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	
	Для каждого Свойство Из СвойстваИсточника Цикл
		Результат.Колонки.Добавить(Свойство.Имя, Новый ОписаниеТипов(Свойство.Тип));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Применяет к таблице источника данных настройки компоновки и отборы правила сопоставления.
//
// Параметры:
//  ТаблицаИсточника - ТаблицаЗначений - таблица данных источника.
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//  НастройкиКомпоновки - Произвольный - настройки компоновки данных или правило сопоставления.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица источника с учётом отборов.
//
Функция ТаблицаИсточникаСОтборами(Знач ТаблицаИсточника, Знач СвойстваИсточника, Знач НастройкиКомпоновки) Экспорт
	
	Если ТипЗнч(НастройкиКомпоновки) = Тип("СправочникСсылка.ТБ_ПравилаСопоставления") Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкиКомпоновки, "КомпоновщикНастроек,ОбработчикПередСопоставлением");
		
		НастройкиКомпоновки           = ЗначенияРеквизитов.КомпоновщикНастроек.Получить();
		ОбработчикПередСопоставлением = ЗначенияРеквизитов.ОбработчикПередСопоставлением;
		
	Иначе
		ОбработчикПередСопоставлением = "";
	КонецЕсли;
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "ДанныеИсточника";
	НаборДанных.ИмяОбъекта = "ТаблицаИсточника";
	НаборДанных.ИсточникДанных = "ИсточникДанных";
	
	Для каждого Свойство Из СвойстваИсточника Цикл
		
		ПолеНабораДанных = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабораДанных.Поле = Свойство.Имя;
		ПолеНабораДанных.ПутьКДанным = Свойство.Имя;
		ПолеНабораДанных.Заголовок = Свойство.Представление;
		
		Если Свойство.Тип = "Строка" Тогда
			ПолеНабораДанных.ТипЗначения = ОбщегоНазначения.ОписаниеТипаСтрока(1024);
		Иначе
			ПолеНабораДанных.ТипЗначения = Новый ОписаниеТипов(Свойство.Тип);
		КонецЕсли;
		
	КонецЦикла;
	
	//
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки));
	
	Если НастройкиКомпоновки = Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновки);
		КомпоновщикНастроек.Восстановить();
	КонецЕсли;
	
	//
	
	НастройкиКомпоновки = КомпоновщикНастроек.Настройки;
	
	ГруппировкаКомпоновки = НастройкиКомпоновки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаКомпоновки.Использование = Истина;
	
	ПолеГруппировки = ГруппировкаКомпоновки.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Использование = Истина;
	
	Для каждого Свойство Из СвойстваИсточника Цикл
		
		ВыбранноеПоле = ГруппировкаКомпоновки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(Свойство.Имя);
		ВыбранноеПоле.Использование = Истина;
		
	КонецЦикла;
	
	//
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкиКомпоновки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ВнешниеНаборыДанных = Новый Структура("ТаблицаИсточника", ТаблицаИсточника);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных);
	
	ТаблицаИсточника = Новый ТаблицаЗначений;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаИсточника);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Если ЗначениеЗаполнено(ОбработчикПередСопоставлением) Тогда
		
		УдаляемыеСтроки = Новый Массив;
		
		КэшированныеЗначения = Неопределено;
		
		Для каждого СтрокаИсточника Из ТаблицаИсточника Цикл
			
			ДанныеИсточника = СтруктураДанныхИсточника(СтрокаИсточника, СвойстваИсточника);
			Отказ = Ложь;
			
			ВыполнитьКодОбработчикаПередСопоставлениемВПопытке(
				ОбработчикПередСопоставлением, ДанныеИсточника, КэшированныеЗначения, Отказ);
			
			Если Отказ Тогда
				УдаляемыеСтроки.Добавить(СтрокаИсточника);
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого СтрокаИсточника Из УдаляемыеСтроки Цикл
			ТаблицаИсточника.Удалить(СтрокаИсточника);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаИсточника;
	
КонецФункции

// Загружает данные из внешнего источника (таблицы внешнего источника или COM-соединения).
//
// Параметры:
//  ТаблицаИсточника - ТаблицаЗначений - таблица, в которую загружаются данные.
//  ИсточникДанных - СправочникСсылка.ТБ_ИсточникиДанных - источник данных.
//  СвойстваИсточника - ТаблицаЗначений, Неопределено - таблица свойств источника данных.
//  ПараметрыОтбора - Структура, Соответствие из КлючИЗначение - параметры отбора данных.
//  Различные - Булево - признак выборки только различных строк.
//  Соединение - Произвольный - установленное соединение с внешним источником.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с загруженными данными.
//
Функция ЗагрузитьИзВнешнегоИсточника(ТаблицаИсточника, Знач ИсточникДанных, Знач СвойстваИсточника,
	Знач ПараметрыОтбора = Неопределено, Знач Различные = Ложь, Соединение = Неопределено) Экспорт
	
	ТаблицаИсточника.Очистить();
	
	ПараметрыИсточника = ПараметрыИсточника(ИсточникДанных);
	
	Если ПараметрыИсточника.ТипИсточника = Перечисления.ТБ_ТипыИсточниковДанных.ВнешнийИсточник Тогда
		
		ЗагрузитьИзТаблицыВнешнегоИсточника(ТаблицаИсточника, ПараметрыИсточника, СвойстваИсточника, ПараметрыОтбора, Различные);
		
	ИначеЕсли ПараметрыИсточника.ТипИсточника = Перечисления.ТБ_ТипыИсточниковДанных.COM1C Тогда
		
		ЗагрузитьИзТаблицыCOMСоединения(ТаблицаИсточника, ПараметрыИсточника, СвойстваИсточника, ПараметрыОтбора, Различные, Соединение);
		
	КонецЕсли;
	
	Возврат ТаблицаИсточника;
	
КонецФункции

// Формирует строковый идентификатор строки источника по свойствам, включаемым в идентификатор.
//
// Параметры:
//  СтрокаИсточника - СтрокаТаблицыЗначений - строка таблицы источника данных.
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//
// Возвращаемое значение:
//  Строка - идентификатор строки источника.
//
Функция ИдентификаторИсточника(СтрокаИсточника, Знач СвойстваИсточника) Экспорт
	
	Строки = Новый Массив;
	
	Для каждого Свойство Из СвойстваИсточника Цикл
		
		Если Свойство.ВключатьВИдентификатор Тогда
			Строки.Добавить(XMLСтрока(СтрокаИсточника[Свойство.Имя]));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, "/");
	
КонецФункции

// Формирует представление строки источника по свойствам, включаемым в представление.
//
// Параметры:
//  СтрокаИсточника - СтрокаТаблицыЗначений - строка таблицы источника данных.
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//
// Возвращаемое значение:
//  Строка - представление строки источника.
//
Функция ПредставлениеИсточника(СтрокаИсточника, Знач СвойстваИсточника) Экспорт
	
	Строки = Новый Массив;
	
	Для каждого Свойство Из СвойстваИсточника Цикл
		
		Если Свойство.ВключатьВПредставление Тогда
			Строки.Добавить(XMLСтрока(СтрокаИсточника[Свойство.Имя]));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, ", ");
	
КонецФункции

// Возвращает структуру данных строки источника по свойствам источника.
//
// Параметры:
//  СтрокаИсточника - СтрокаТаблицыЗначений - строка таблицы источника данных.
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//
// Возвращаемое значение:
//  Структура - данные строки источника.
//
Функция СтруктураДанныхИсточника(СтрокаИсточника, Знач СвойстваИсточника) Экспорт
	
	Результат = Новый Структура;
	
	Для каждого Свойство Из СвойстваИсточника Цикл
		Результат.Вставить(Свойство.Имя, СтрокаИсточника[Свойство.Имя]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует параметры отбора объекта по идентификатору для правила сопоставления.
//
// Параметры:
//  ПравилоСопоставления - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//  ДанныеИсточника - Структура - данные строки источника.
//
// Возвращаемое значение:
//  Структура - параметры отбора по идентификатору.
//
Функция ПараметрыОтбораИдентификатора(Знач ПравилоСопоставления, Знач ДанныеИсточника) Экспорт
	
	Результат = Новый Структура;
	
	Если ЗначениеЗаполнено(ДанныеИсточника) Тогда
		
		Для каждого Свойство Из Справочники.ТБ_ПравилаСопоставления.СвойстваИдентификатора(ПравилоСопоставления) Цикл
			
			ПараметрыПоля = ПараметрыПоляОтбора();
			ПараметрыПоля.Значение  = ДанныеИсточника[Свойство.Имя];
			ПараметрыПоля.Тип       = Свойство.Тип;
			ПараметрыПоля.ТипСсылки = Свойство.ТипСсылки;
			
			Результат.Вставить(Свойство.Имя, ПараметрыПоля);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру параметров поля отбора.
//
// Возвращаемое значение:
//  Структура - параметры поля отбора:
//   * Значение - Произвольный, Неопределено - значение поля отбора;
//   * Тип - Строка - тип поля отбора;
//   * ТипСсылки - Строка - тип ссылки поля отбора.
//
Функция ПараметрыПоляОтбора() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Значение",  Неопределено);
	Результат.Вставить("Тип",       "");
	Результат.Вставить("ТипСсылки", "");
	
	Возврат Результат;
	
КонецФункции

// Инициализирует компоновщик настроек схемой компоновки данных по свойствам источника.
//
// Параметры:
//  КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - компоновщик настроек, который требуется инициализировать.
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для размещения схемы во временном хранилище.
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//  НастройкиКомпоновки - НастройкиКомпоновкиДанных, Неопределено - настройки компоновки данных.
//
Процедура ИнициализироватьКомпоновщик(КомпоновщикНастроек, Знач УникальныйИдентификатор, Знач СвойстваИсточника, Знач НастройкиКомпоновки = Неопределено) Экспорт
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "ДанныеИсточника";
	НаборДанных.ИмяОбъекта = "ТаблицаДанных";
	НаборДанных.ИсточникДанных = "ИсточникДанных";
	
	Для каждого Свойство Из СвойстваИсточника Цикл
		
		ПолеНабораДанных = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабораДанных.Поле = Свойство.Имя;
		ПолеНабораДанных.ПутьКДанным = Свойство.Имя;
		ПолеНабораДанных.Заголовок = Свойство.Представление;
		
		Если Свойство.Тип = "Строка" Тогда
			ПолеНабораДанных.ТипЗначения = ОбщегоНазначения.ОписаниеТипаСтрока(1024);
		Иначе
			ПолеНабораДанных.ТипЗначения = Новый ОписаниеТипов(Свойство.Тип);
		КонецЕсли;
		
	КонецЦикла;
	
	АдресСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));
	
	Если НастройкиКомпоновки = Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновки);
		КомпоновщикНастроек.Восстановить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Возвращает таблицу значений для хранения соответствия объектов и данных источника.
//
// Параметры:
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица соответствия.
//
Функция ТаблицаСоответствия(Знач СвойстваИсточника) Экспорт
	
	Результат = РегистрыСведений.ТБ_СоответствияОбъектов.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Для каждого Свойство Из СвойстваИсточника Цикл
		Результат.Колонки.Добавить(Свойство.Имя, Новый ОписаниеТипов(Свойство.Тип));
	КонецЦикла;
	
	Результат.Колонки.Добавить("ИдентификаторСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	Результат.Колонки.Добавить("Сопоставлено",        Новый ОписаниеТипов("Булево"));
	
	Возврат Результат;
	
КонецФункции

#Область ПараметрыСопоставления

// Возвращает структуру параметров сопоставления объектов.
//
// Параметры:
//  Правило - СправочникСсылка.ТБ_ПравилаСопоставления, Неопределено - правило сопоставления.
//
// Возвращаемое значение:
//  Структура - параметры сопоставления:
//   * ТаблицаРеквизитов - ТаблицаЗначений - таблица реквизитов объекта;
//   * ТаблицаДопРеквизитов - ТаблицаЗначений - таблица дополнительных реквизитов объекта;
//   * СоздаватьНовыеЗначенияСвойств - Булево - признак создания новых значений свойств;
//   * СоздаватьНовыеОбъекты - Булево - признак создания новых объектов;
//   * ОбновлятьСуществующиеОбъекты - Булево - признак обновления существующих объектов;
//   * ОчищатьТабличнуюЧасть - Булево - признак очистки табличной части;
//   * РежимРазработчика - Булево - признак режима разработчика;
//   * СозданныеОбъекты - Массив из Произвольный - ссылки на созданные объекты;
//   * ИзмененныеОбъекты - Массив из Произвольный - ссылки на изменённые объекты;
//   * ОписаниеОшибок - Массив из Структура - описание ошибок;
//   * ВыводитьСообщения - Булево - признак вывода сообщений.
//
Функция ПараметрыСопоставления(Знач Правило = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаРеквизитов",             ТаблицаРеквизитов());
	Результат.Вставить("ТаблицаДопРеквизитов",          ТаблицаДопРеквизитов());
	Результат.Вставить("СоздаватьНовыеЗначенияСвойств", Ложь);
	Результат.Вставить("СоздаватьНовыеОбъекты",         Ложь);
	Результат.Вставить("ОбновлятьСуществующиеОбъекты",  Ложь);
	Результат.Вставить("ОчищатьТабличнуюЧасть",         Ложь);
	Результат.Вставить("РежимРазработчика",             Ложь);
	Результат.Вставить("СозданныеОбъекты",              Новый Массив);
	Результат.Вставить("ИзмененныеОбъекты",             Новый Массив);
	Результат.Вставить("ОписаниеОшибок",                Новый Массив);
	Результат.Вставить("ВыводитьСообщения",             Истина);
	
	Если ЗначениеЗаполнено(Правило) Тогда
		
		ЗагрузитьПравилоСопоставления(
			Правило,
			Результат.ТаблицаРеквизитов,
			Результат.ТаблицаДопРеквизитов);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Загружает реквизиты и дополнительные реквизиты правила сопоставления в таблицы.
//
// Параметры:
//  Правило - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//  ТаблицаРеквизитов - ТаблицаЗначений - таблица реквизитов объекта.
//  ТаблицаДопРеквизитов - ТаблицаЗначений - таблица дополнительных реквизитов объекта.
//
Процедура ЗагрузитьПравилоСопоставления(Знач Правило, ТаблицаРеквизитов, ТаблицаДопРеквизитов) Экспорт
	
	Если Не ЗначениеЗаполнено(Правило) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Правило, "ИмяОбъекта,ВидНоменклатуры");
	
	// Заполнение таблицы реквизитов.
	ЗаполнитьТаблицуРеквизитов(ТаблицаРеквизитов, Правило);
	ЗаполнитьЗаполнятьОбязательноВТаблицеРеквизитов(
		ТаблицаРеквизитов,
		ЗначенияРеквизитов.ИмяОбъекта,
		ЗначенияРеквизитов.ВидНоменклатуры);
	
	// Заполнение таблицы доп. реквизитов.
	ЗаполнитьТаблицуДопРеквизитов(ТаблицаДопРеквизитов, Правило);
	ЗаполнитьЗаполнятьОбязательноВТаблицеДопРеквизитов(
		ТаблицаДопРеквизитов,
		ЗначенияРеквизитов.ИмяОбъекта,
		ЗначенияРеквизитов.ВидНоменклатуры);
	
КонецПроцедуры

// Заполняет признак заполнения реквизитов по умолчанию для таблицы реквизитов.
//
// Параметры:
//  Таблица - ТаблицаЗначений - таблица реквизитов объекта.
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных.
//  ВидНоменклатуры - СправочникСсылка.ВидыНоменклатуры - вид номенклатуры.
//
Процедура ЗаполнитьЗаполнятьОбязательноВТаблицеРеквизитов(Таблица, Знач ПолноеИмяОбъекта, Знач ВидНоменклатуры) Экспорт
	
	ВладелецРеквизитов = СтрЗаменить(ПолноеИмяОбъекта, "Справочник.", "");
	
	Если ВладелецРеквизитов = "Номенклатура"
		Или ВладелецРеквизитов = "ХарактеристикиНоменклатуры" Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидНоменклатуры,
			"ТипНоменклатуры,ОсобенностьУчета,ИспользоватьХарактеристики,ИспользоватьСрокГодностиСерии");
		
		Если ВладелецРеквизитов = "Номенклатура" Тогда
			
			ЗависимостьОтТипаНоменклатуры = ЗначениеНастроекПовтИсп.ВсеРеквизитыНоменклатуры(
				ЗначенияРеквизитов.ТипНоменклатуры,
				ЗначенияРеквизитов.ОсобенностьУчета,
				ЗначенияРеквизитов.ИспользоватьХарактеристики,
				ЗначенияРеквизитов.ИспользоватьСрокГодностиСерии);
			
		ИначеЕсли ВладелецРеквизитов = "ХарактеристикиНоменклатуры" Тогда
			
			ЗависимостьОтТипаНоменклатуры = ЗначениеНастроекПовтИсп.ВсеРеквизитыХарактеристикНоменклатуры(
				ЗначенияРеквизитов.ТипНоменклатуры,
				ЗначенияРеквизитов.ОсобенностьУчета);
			
		КонецЕсли;
		
		Для каждого СтрокаТаблицы Из Таблица Цикл
			
			НастройкаОтТипа = Неопределено;
			
			Если ЗависимостьОтТипаНоменклатуры.Свойство(СтрокаТаблицы.Имя, НастройкаОтТипа) Тогда
				СтрокаТаблицы.ЗаполнятьОбязательноПоУмолчанию = НастройкаОтТипа.ОбязательныйДляЗаполнения;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет признак заполнения дополнительных реквизитов по умолчанию.
//
// Параметры:
//  Таблица - ТаблицаЗначений - таблица дополнительных реквизитов объекта.
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных.
//  ВидНоменклатуры - СправочникСсылка.ВидыНоменклатуры - вид номенклатуры.
//
Процедура ЗаполнитьЗаполнятьОбязательноВТаблицеДопРеквизитов(Таблица, Знач ПолноеИмяОбъекта, Знач ВидНоменклатуры) Экспорт
	
	ВладелецРеквизитов = СтрЗаменить(ПолноеИмяОбъекта, "Справочник.", "");
	
	Если ВладелецРеквизитов = "Номенклатура"
		Или ВладелецРеквизитов = "ХарактеристикиНоменклатуры" Тогда
		
		ВсеДопРеквизиты = Справочники.Номенклатура.ВсеДополнительныеРеквизиты(ВидНоменклатуры, ВладелецРеквизитов);
		
		Для каждого СтрокаТаблицы Из Таблица Цикл
			
			НайденныеСтроки = ВсеДопРеквизиты.НайтиСтроки(Новый Структура("Свойство", СтрокаТаблицы.Свойство));
			Если НайденныеСтроки.Количество() <> 0 Тогда
				СтрокаТаблицы.ЗаполнятьОбязательноПоУмолчанию = НайденныеСтроки[0].ЗаполнятьОбязательно;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Если ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
			Свойства = Таблица.ВыгрузитьКолонку("Свойство");
		Иначе
			Свойства = Таблица.Выгрузить(, "Свойство").ВыгрузитьКолонку("Свойство");
		КонецЕсли;
		
		ИмяРеквизитаЗаполнятьОбязательно = "ЗаполнятьОбязательно";
		ЗаполнятьОбязательно = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Свойства, ИмяРеквизитаЗаполнятьОбязательно);
		
		Для каждого СтрокаТаблицы Из Таблица Цикл
			СтрокаТаблицы.ЗаполнятьОбязательноПоУмолчанию = ЗаполнятьОбязательно.Получить(СтрокаТаблицы.Свойство);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Сопоставление

// Возвращает таблицу данных для сопоставления с колонками реквизитов и дополнительных реквизитов.
//
// Параметры:
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица данных для сопоставления.
//
Функция ТаблицаДанныхДляСопоставления(ПараметрыСопоставления) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИдентификаторСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	Результат.Колонки.Добавить("Идентификатор",       ОбщегоНазначения.ОписаниеТипаСтрока(250));
	Результат.Колонки.Добавить("ДанныеИсточника",     Новый ОписаниеТипов("Структура"));
	
	Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаРеквизитов Цикл
		Результат.Колонки.Добавить(СтрокаТаблицы.ПолноеИмя, СтрокаТаблицы.ТипЗначения);
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаДопРеквизитов Цикл
		Результат.Колонки.Добавить(СтрокаТаблицы.ПолноеИмя, СтрокаТаблицы.ТипЗначения);
	КонецЦикла;
	
	Результат.Колонки.Добавить("Объект", Метаданные.РегистрыСведений.ТБ_СоответствияОбъектов.Ресурсы.Объект.Тип);
	Результат.Колонки.Добавить("Отказ",  Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ПредставлениеСсылкиОбъекта", Новый ОписаниеТипов("Строка"));

	Возврат Результат;
	
КонецФункции

// Добавляет в таблицу данных строку с данными источника.
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица данных для сопоставления.
//  ИдентификаторСтроки - Число - номер строки данных.
//  Идентификатор - Строка - идентификатор строки источника.
//  ДанныеИсточника - Структура - данные строки источника.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - добавленная строка данных.
//
Функция ДобавитьСтрокуДанных(ТаблицаДанных, Знач ИдентификаторСтроки, Знач Идентификатор, Знач ДанныеИсточника, ПараметрыСопоставления) Экспорт
	
	НоваяСтрока = ТаблицаДанных.Добавить();
	НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
	НоваяСтрока.Идентификатор       = Идентификатор;
	НоваяСтрока.ДанныеИсточника     = ДанныеИсточника;
	
	Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаРеквизитов Цикл
		//НоваяСтрока[СтрокаТаблицы.ПолноеИмя] = ПолучитьЗначение(СтрокаТаблицы, ДанныеИсточника, ПараметрыСопоставления, Ложь, НоваяСтрока.Отказ);
		текЗначениеРеквизита = ПолучитьЗначение(СтрокаТаблицы, ДанныеИсточника, ПараметрыСопоставления, Ложь, НоваяСтрока.Отказ);
		НоваяСтрока[СтрокаТаблицы.ПолноеИмя] = текЗначениеРеквизита;
		Если СтрокаТаблицы.ПолноеИмя = "Объект_Ссылка" 
			И Не ТаблицаДанных.Колонки.Найти("ПредставлениеСсылкиОбъекта") = Неопределено 
			И ТипЗнч(текЗначениеРеквизита) = Тип("Строка") Тогда
			НоваяСтрока["ПредставлениеСсылкиОбъекта"] = текЗначениеРеквизита;
			Если Не ЗначениеЗаполнено(НоваяСтрока[СтрокаТаблицы.ПолноеИмя]) И ЗначениеЗаполнено(НоваяСтрока["ПредставлениеСсылкиОбъекта"]) Тогда
				МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(НоваяСтрока[СтрокаТаблицы.ПолноеИмя]);
				текСсылка = МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(НоваяСтрока["ПредставлениеСсылкиОбъекта"]));
				Если ОбщегоНазначения.СсылкаСуществует(текСсылка) Тогда 
					НоваяСтрока[СтрокаТаблицы.ПолноеИмя] = текСсылка;
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаДопРеквизитов Цикл
		НоваяСтрока[СтрокаТаблицы.ПолноеИмя] = ПолучитьЗначение(СтрокаТаблицы, ДанныеИсточника, ПараметрыСопоставления, Истина, НоваяСтрока.Отказ);
	КонецЦикла;
	
	Возврат НоваяСтрока;
	
КонецФункции

// Добавляет в таблицу данных строку по реквизитам указанного объекта.
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица данных для сопоставления.
//  Идентификатор - Строка - идентификатор строки источника.
//  Объект - Произвольный - объект, реквизиты которого заполняют строку.
//  Правило - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - добавленная строка данных.
//
Функция ДобавитьСтрокуДанныхПоОбъекту(ТаблицаДанных, Знач Идентификатор, Знач Объект, Знач Правило, ПараметрыСопоставления) Экспорт
	
	НоваяСтрока = ТаблицаДанных.Добавить();
	НоваяСтрока.Идентификатор = Идентификатор;
	
	Если ЗначениеЗаполнено(Объект)
		И ПараметрыСопоставления.ТаблицаРеквизитов.Количество() <> 0 Тогда
		
		ИменаРеквизитов = Новый Массив;
		
		Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаРеквизитов Цикл
			ИменаРеквизитов.Добавить(СтрокаТаблицы.Имя);
		КонецЦикла;
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, СтрСоединить(ИменаРеквизитов, ","));
		
		Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаРеквизитов Цикл
			НоваяСтрока[СтрокаТаблицы.ПолноеИмя] = ЗначенияРеквизитов[СтрокаТаблицы.Имя];
		КонецЦикла;
		
	КонецЕсли;
	
	//
	
	Если ЗначениеЗаполнено(Объект)
		И ПараметрыСопоставления.ТаблицаДопРеквизитов.Количество() <> 0 Тогда
		
		Свойства = Новый Массив;
		
		Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаДопРеквизитов Цикл
			Свойства.Добавить(СтрокаТаблицы.Свойство);
		КонецЦикла;
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДопРеквизиты.Свойство КАК Свойство,
		|	ДопРеквизиты.Значение КАК Значение
		|ИЗ
		|	%1.ДополнительныеРеквизиты КАК ДопРеквизиты
		|ГДЕ
		|	ДопРеквизиты.Ссылка = &Объект
		|	И ДопРеквизиты.Свойство В(&Свойства)";
		
		ПолноеИмяОбъекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Правило, "ИмяОбъекта");
		ТекстЗапроса = СтрШаблон(ТекстЗапроса, ПолноеИмяОбъекта);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Объект",   Объект);
		Запрос.УстановитьПараметр("Свойства", Свойства);
		
		ЗначенияРеквизитов = Запрос.Выполнить().Выгрузить();
		
		Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаДопРеквизитов Цикл
			
			НайденныеЗначения = ЗначенияРеквизитов.НайтиСтроки(Новый Структура("Свойство", СтрокаТаблицы.Свойство));
			НоваяСтрока[СтрокаТаблицы.ПолноеИмя] = ?(НайденныеЗначения.Количество() = 0, Неопределено, НайденныеЗначения[0].Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НоваяСтрока;
	
КонецФункции

// Добавляет в таблицу данных строку со значениями реквизитов из параметров сопоставления.
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица данных для сопоставления.
//  Идентификатор - Строка - идентификатор строки источника.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - добавленная строка данных.
//
Функция ДобавитьСтрокуДанныхПоЗначениям(ТаблицаДанных, Знач Идентификатор, ПараметрыСопоставления) Экспорт
	
	НоваяСтрока = ТаблицаДанных.Добавить();
	НоваяСтрока.Идентификатор = Идентификатор;
	
	Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаРеквизитов Цикл
		НоваяСтрока[СтрокаТаблицы.ПолноеИмя] = СтрокаТаблицы.Значение;
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаДопРеквизитов Цикл
		НоваяСтрока[СтрокаТаблицы.ПолноеИмя] = СтрокаТаблицы.Значение;
	КонецЦикла;
	
	Возврат НоваяСтрока;
	
КонецФункции

// Проверяет заполнение обязательных реквизитов в строке данных.
//
// Параметры:
//  СтрокаДанных - СтрокаТаблицыЗначений - строка данных для сопоставления.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//
// Возвращаемое значение:
//  Массив из Строка - представления незаполненных обязательных реквизитов.
//
Функция ПроверитьЗаполнениеСтрокиДанных(СтрокаДанных, ПараметрыСопоставления) Экспорт
	
	Результат = Новый Массив;
	
	Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаРеквизитов Цикл
		
		Если (СтрокаТаблицы.ЗаполнятьОбязательно Или СтрокаТаблицы.ЗаполнятьОбязательноПоУмолчанию)
			И Не ЗначениеЗаполнено(СтрокаДанных[СтрокаТаблицы.ПолноеИмя]) Тогда
			Результат.Добавить("""" + СтрокаТаблицы.Представление + """");
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из ПараметрыСопоставления.ТаблицаДопРеквизитов Цикл
		
		Если (СтрокаТаблицы.ЗаполнятьОбязательно Или СтрокаТаблицы.ЗаполнятьОбязательноПоУмолчанию)
			И Не ЗначениеЗаполнено(СтрокаДанных[СтрокаТаблицы.ПолноеИмя]) Тогда
			Результат.Добавить("""" + СтрокаТаблицы.Представление + """");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Находит или создаёт объекты по таблице данных в соответствии с правилом сопоставления.
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица данных для сопоставления.
//  Правило - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//  Отказ - Булево - признак отказа от выполнения операции.
//
Процедура НайтиСоздатьОбъекты(ТаблицаДанных, Знач Правило, ПараметрыСопоставления, Отказ) Экспорт
	
	ПараметрыОбъекта = ПараметрыОбъекта(Правило, ПараметрыСопоставления);
	
	Если ПараметрыОбъекта.ВсеПоляПоиска.Количество() = 0 Тогда
		
		ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
			НСтр("ru = 'Не указаны поля поиска для сопоставляемых объектов'"),
			,
			Отказ);
		Возврат;
		
	КонецЕсли;
	
	// { +Аксиома
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Правило, "ТипПравила") = ПредопределенноеЗначение("Перечисление.ТБ_ТипыПравилСопоставления.СопоставлениеОбъектов")
		И Не ПараметрыОбъекта.ПоляПоиска.Найти("Ссылка") = Неопределено Тогда 
		ИмяКолонкиОбъектСсылка = "Объект_Ссылка";
		Для Каждого СтрокаДанных Из ТаблицаДанных Цикл 
			Если ЗначениеЗаполнено(СтрокаДанных[ИмяКолонкиОбъектСсылка]) Тогда 
				НайденнаяСсылка = СтрокаДанных[ИмяКолонкиОбъектСсылка];
			ИначеЕсли Не ЗначениеЗаполнено(СтрокаДанных.ПредставлениеСсылкиОбъекта) Тогда 
				НайденнаяСсылка = СтрокаДанных[ИмяКолонкиОбъектСсылка];
			Иначе 
				НайденнаяСсылка = ПараметрыОбъекта.МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаДанных.ПредставлениеСсылкиОбъекта));
			КонецЕсли;
			Если Не ОбщегоНазначения.СсылкаСуществует(НайденнаяСсылка) Тогда 
				Если ПараметрыСопоставления.СоздаватьНовыеОбъекты Тогда
						
					ДанныеОбъекта = СоздатьИзменитьОбъект(Неопределено, ПараметрыОбъекта, СтрокаДанных, ПараметрыСопоставления);
					
					Если ДанныеОбъекта <> Неопределено
						И ЗаписатьОбъект(ДанныеОбъекта, ПараметрыОбъекта, СтрокаДанных.ДанныеИсточника, ПараметрыСопоставления) Тогда
						
						Ссылка = ДанныеОбъекта.Ссылка;
						ПараметрыСопоставления.СозданныеОбъекты.Добавить(Ссылка);
						
					Иначе
						Ссылка = ПараметрыОбъекта.МенеджерОбъекта.ПустаяСсылка();
					КонецЕсли;
					
					СтрокаДанных.Объект = Ссылка;
					
				Иначе
					
					ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
								СтрШаблон(НСтр("ru = 'Не найден объект ""%1"" по полям поиска: %2'"),
								ПараметрыОбъекта.ПредставлениеОбъекта,
								"Ссылка"));
					
				КонецЕсли;
			Иначе 
					
				Ссылка = НайденнаяСсылка;
				
				Если ПараметрыСопоставления.ОбновлятьСуществующиеОбъекты Тогда
					
					ДанныеОбъекта = СоздатьИзменитьОбъект(Ссылка, ПараметрыОбъекта, СтрокаДанных, ПараметрыСопоставления);
					
					Если ДанныеОбъекта <> Неопределено
						И ЗаписатьОбъект(ДанныеОбъекта, ПараметрыОбъекта, СтрокаДанных.ДанныеИсточника, ПараметрыСопоставления) Тогда
						
						Ссылка = ДанныеОбъекта.Ссылка;
						ПараметрыСопоставления.ИзмененныеОбъекты.Добавить(Ссылка);
						
					Иначе
						Ссылка = ПараметрыОбъекта.МенеджерОбъекта.ПустаяСсылка();
					КонецЕсли;
					
				КонецЕсли;
				
				СтрокаДанных.Объект = Ссылка;
					
			КонецЕсли;
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	// } -Аксиома
	
	ТаблицаПоиска   = ТаблицаПоиска(ТаблицаДанных, ПараметрыОбъекта);
	ПараметрыПоиска = Новый Структура(ПараметрыОбъекта.ИменаВсехПолейПоиска);
	
	Для каждого СтрокаПоиска Из ТаблицаПоиска Цикл
		
		ЗаполнитьЗначенияСвойств(ПараметрыПоиска, СтрокаПоиска);
		
		ТаблицаСсылок    = ТБ_ЗагрузкаОбъектов.ТаблицаСсылокПоПараметрам(ПараметрыПоиска, ПараметрыОбъекта);
		КоличествоСсылок = ТаблицаСсылок.Количество();
		
		Если КоличествоСсылок = 0 Тогда
			
			Если ПараметрыСопоставления.СоздаватьНовыеОбъекты Тогда
				
				ПараметрыОтбора = ПараметрыОтбораТаблицыДанных(ПараметрыПоиска, ПараметрыОбъекта);
				СтрокиДанных    = ТаблицаДанных.НайтиСтроки(ПараметрыОтбора);
				
				Если СтрокиДанных.Количество() <> 0 Тогда
					
					СтрокаДанных = СтрокиДанных[0];
					
					ДанныеОбъекта = СоздатьИзменитьОбъект(Неопределено, ПараметрыОбъекта, СтрокаДанных, ПараметрыСопоставления);
					
					Если ДанныеОбъекта <> Неопределено
						И ЗаписатьОбъект(ДанныеОбъекта, ПараметрыОбъекта, СтрокаДанных.ДанныеИсточника, ПараметрыСопоставления) Тогда
						
						Ссылка = ДанныеОбъекта.Ссылка;
						ПараметрыСопоставления.СозданныеОбъекты.Добавить(Ссылка);
						
					Иначе
						Ссылка = ПараметрыОбъекта.МенеджерОбъекта.ПустаяСсылка();
					КонецЕсли;
					
					Для каждого СтрокаДанных Из СтрокиДанных Цикл
						СтрокаДанных.Объект = Ссылка;
					КонецЦикла;
					
				КонецЕсли;
				
			Иначе
				
				ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
					СтрШаблон(НСтр("ru = 'Не найден объект ""%1"" по полям поиска: %2'"),
						ПараметрыОбъекта.ПредставлениеОбъекта,
						ПредставлениеПоиска(ПараметрыПоиска, ПараметрыОбъекта)));
				
			КонецЕсли;
			
		ИначеЕсли КоличествоСсылок = 1 Тогда
			
			ПараметрыОтбора = ПараметрыОтбораТаблицыДанных(ПараметрыПоиска, ПараметрыОбъекта);
			СтрокиДанных    = ТаблицаДанных.НайтиСтроки(ПараметрыОтбора);
			
			Если СтрокиДанных.Количество() <> 0 Тогда
				
				Ссылка = ТаблицаСсылок[0].Ссылка;
				
				Если ПараметрыСопоставления.ОбновлятьСуществующиеОбъекты Тогда
					
					СтрокаДанных = СтрокиДанных[0];
					
					ДанныеОбъекта = СоздатьИзменитьОбъект(Ссылка, ПараметрыОбъекта, СтрокаДанных, ПараметрыСопоставления);
					
					Если ДанныеОбъекта <> Неопределено
						И ЗаписатьОбъект(ДанныеОбъекта, ПараметрыОбъекта, СтрокаДанных.ДанныеИсточника, ПараметрыСопоставления) Тогда
						
						Ссылка = ДанныеОбъекта.Ссылка;
						ПараметрыСопоставления.ИзмененныеОбъекты.Добавить(Ссылка);
						
					Иначе
						Ссылка = ПараметрыОбъекта.МенеджерОбъекта.ПустаяСсылка();
					КонецЕсли;
					
				КонецЕсли;
				
				Для каждого СтрокаДанных Из СтрокиДанных Цикл
					СтрокаДанных.Объект = Ссылка;
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли КоличествоСсылок > 1 Тогда
			
			ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
				СтрШаблон(НСтр("ru = 'Найдено несколько объектов ""%1"" по полям поиска: %2'"),
					ПараметрыОбъекта.ПредставлениеОбъекта,
					ПредставлениеПоиска(ПараметрыПоиска, ПараметрыОбъекта)));
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Обработчики

// Выполняет код обработчика ПередСопоставлением с перехватом исключений.
//
// Параметры:
//  ИсполняемыйКод - Строка - исполняемый код обработчика.
//  ДанныеИсточника - Структура - данные строки источника.
//  КэшированныеЗначения - Произвольный - кэшированные значения обработчика.
//  Отказ - Булево - признак отказа от выполнения операции.
//
Процедура ВыполнитьКодОбработчикаПередСопоставлениемВПопытке(Знач ИсполняемыйКод, Знач ДанныеИсточника, КэшированныеЗначения, Отказ) Экспорт
	
	Если Отказ Или Не ЗначениеЗаполнено(ИсполняемыйКод) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ВыполнитьКодОбработчикаПередСопоставлением(ИсполняемыйКод, ДанныеИсточника, КэшированныеЗначения, Отказ);
	Исключение
		
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка выполнения обработчика ПередСопоставлением:
		|%1'"),
		КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
КонецПроцедуры

// Выполняет код обработчика ПередОбработкой с перехватом исключений.
//
// Параметры:
//  Объект - Произвольный - объект, для которого выполняется обработчик.
//  ПараметрыОбъекта - Структура - параметры сопоставляемого объекта.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//  Отказ - Булево - признак отказа от выполнения операции.
//
Процедура ВыполнитьКодОбработчикаПередОбработкойВПопытке(Объект, Знач ПараметрыОбъекта, ПараметрыСопоставления, Отказ) Экспорт
	
	Если Отказ Или Не ЗначениеЗаполнено(ПараметрыОбъекта.ОбработчикПередОбработкой) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ВыполнитьКодОбработчикаПередОбработкой(Объект, ПараметрыОбъекта.ОбработчикПередОбработкой, Отказ);
	Исключение
		
		ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
			СтрШаблон(НСтр("ru = 'Ошибка выполнения обработчика ПередОбработкой для объекта ""%1"":
			|%2'"),
			ПараметрыОбъекта.ПредставлениеОбъекта,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		
	КонецПопытки;
	
	ДобавитьСообщенияВОписаниеОшибок(ПараметрыСопоставления);
	
КонецПроцедуры

// Выполняет код обработчика ПослеЗаполненияСтроки с перехватом исключений.
//
// Параметры:
//  Объект - Произвольный - объект, для которого выполняется обработчик.
//  СтрокаТаблицы - СтрокаТаблицыЗначений - строка таблицы, заполняемая обработчиком.
//  ПараметрыОбъекта - Структура - параметры сопоставляемого объекта.
//  ДанныеИсточника - Структура - данные строки источника.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//  Отказ - Булево - признак отказа от выполнения операции.
//
Процедура ВыполнитьКодОбработчикаПослеЗаполненияСтрокиВПопытке(Объект, СтрокаТаблицы, Знач ПараметрыОбъекта, Знач ДанныеИсточника, ПараметрыСопоставления, Отказ) Экспорт
	
	Если Отказ Или Не ЗначениеЗаполнено(ПараметрыОбъекта.ОбработчикПослеЗаполненияСтрокиТаблицы) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ВыполнитьКодОбработчикаПослеЗаполненияСтроки(
			Объект, СтрокаТаблицы, ПараметрыОбъекта.ОбработчикПослеЗаполненияСтрокиТаблицы, ДанныеИсточника, Отказ);
	Исключение
		
		ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
			СтрШаблон(НСтр("ru = 'Ошибка выполнения обработчика ПослеЗаполненияСтроки для объекта ""%1"":
			|%2'"),
			ПараметрыОбъекта.ПредставлениеОбъекта,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		
	КонецПопытки;
	
	ДобавитьСообщенияВОписаниеОшибок(ПараметрыСопоставления);
	
КонецПроцедуры

// Выполняет код обработчика ПередЗаписью с перехватом исключений.
//
// Параметры:
//  Объект - Произвольный - объект, для которого выполняется обработчик.
//  ПараметрыОбъекта - Структура - параметры сопоставляемого объекта.
//  ДанныеИсточника - Структура - данные строки источника.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//  Отказ - Булево - признак отказа от выполнения операции.
//
Процедура ВыполнитьКодОбработчикаПередЗаписьюВПопытке(Объект, Знач ПараметрыОбъекта, Знач ДанныеИсточника, ПараметрыСопоставления, Отказ) Экспорт
	
	Если Отказ Или Не ЗначениеЗаполнено(ПараметрыОбъекта.ОбработчикПередЗаписью) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ВыполнитьКодОбработчикаПередЗаписью(Объект, ПараметрыОбъекта.ОбработчикПередЗаписью, ДанныеИсточника, Отказ);
	Исключение
		
		ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
			СтрШаблон(НСтр("ru = 'Ошибка выполнения обработчика ПередЗаписью для объекта ""%1"":
			|%2'"),
			ПараметрыОбъекта.ПредставлениеОбъекта,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		
	КонецПопытки;
	
	ДобавитьСообщенияВОписаниеОшибок(ПараметрыСопоставления);
	
КонецПроцедуры

// Выполняет код обработчика ПослеЗаписи с перехватом исключений.
//
// Параметры:
//  Объект - Произвольный - объект, для которого выполняется обработчик.
//  ПараметрыОбъекта - Структура - параметры сопоставляемого объекта.
//  ДанныеИсточника - Структура - данные строки источника.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//  Отказ - Булево - признак отказа от выполнения операции.
//
Процедура ВыполнитьКодОбработчикаПослеЗаписиВПопытке(Объект, Знач ПараметрыОбъекта, Знач ДанныеИсточника, ПараметрыСопоставления, Отказ) Экспорт
	
	Если Отказ Или Не ЗначениеЗаполнено(ПараметрыОбъекта.ОбработчикПослеЗаписи) Тогда
		Возврат;
