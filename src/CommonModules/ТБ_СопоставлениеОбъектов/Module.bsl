КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаОбъектов

// Загружает данные объекта из источника по сохранённому соответствию.
//
// Параметры:
//  Ссылка - Произвольный - ссылка на загружаемый объект.
//  ОписаниеОшибок - Массив из Структура, Неопределено - описание возникших ошибок.
//
Процедура ЗагрузитьОбъект(Знач Ссылка, ОписаниеОшибок = Неопределено) Экспорт
	
	ОписаниеОшибок = НовоеОписаниеОшибок(ОписаниеОшибок);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	НастройкиЗагрузкиОбъектов.Ссылка КАК НастройкаЗагрузки,
	|	СоответствияОбъектов.ИсточникДанных КАК ИсточникДанных,
	|	СоответствияОбъектов.ДанныеИсточника КАК ДанныеИсточника,
	|	СоответствияОбъектов.ПравилоСопоставления КАК ПравилоСопоставления
	|ИЗ
	|	РегистрСведений.ТБ_СоответствияОбъектов КАК СоответствияОбъектов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТБ_НастройкиЗагрузкиОбъектов КАК НастройкиЗагрузкиОбъектов
	|		ПО СоответствияОбъектов.ИмяОбъекта = НастройкиЗагрузкиОбъектов.ИмяОбъекта
	|			И СоответствияОбъектов.ПравилоСопоставления = НастройкиЗагрузкиОбъектов.ПравилоСопоставления
	|ГДЕ
	|	СоответствияОбъектов.Объект = &Объект");
	
	Запрос.УстановитьПараметр("Объект", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КоличествоЗаписей = Выборка.Количество();
	Если КоличествоЗаписей = 0 Тогда
		
		ДобавитьОписаниеОшибки(ОписаниеОшибок, НСтр("ru = 'Не найдено соответствие объекту источника'"));
		Возврат;
		
	ИначеЕсли КоличествоЗаписей > 1 Тогда
		
		ДобавитьОписаниеОшибки(ОписаниеОшибок, НСтр("ru = 'Найдено несколько соответствий источнику'"));
		Возврат;
		
	КонецЕсли;
	
	Выборка.Следующий();
	
	ПараметрыЗагрузки = ТБ_ЗагрузкаОбъектов.ПараметрыЗагрузки(Выборка.НастройкаЗагрузки);
	
	ИменаСвойствСоЗначениямиДата = Справочники.ТБ_ИсточникиДанных.ИменаСвойствСоЗначениямиДата(Выборка.ИсточникДанных);
	СтруктураДанных = ЗначениеJSON(Выборка.ДанныеИсточника, ИменаСвойствСоЗначениямиДата);
	ПараметрыОтбора = ПараметрыОтбораИдентификатора(Выборка.ПравилоСопоставления, СтруктураДанных);
	
	ЗагрузитьДанныеОбъекта(Ссылка, ПараметрыЗагрузки, ПараметрыОтбора, ОписаниеОшибок);
	
КонецПроцедуры

// Возвращает таблицу данных для сопоставления, заполненную значениями полей источника.
//
// Параметры:
//  ТаблицаИсточника - ТаблицаЗначений - таблица данных источника.
//  ПараметрыСопоставления - Структура - параметры сопоставления.
//  СвойстваИсточника - ТаблицаЗначений - таблица свойств источника данных.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица данных для сопоставления.
//
Функция ТаблицаДанныхСоЗначениямиПолей(ТаблицаИсточника, ПараметрыСопоставления, Знач СвойстваИсточника) Экспорт
	
	ТаблицаДанных = ТаблицаДанныхДляСопоставления(ПараметрыСопоставления);
	
	Для каждого СтрокаИсточника Из ТаблицаИсточника Цикл
		
		СтрокаДанных = ДобавитьСтрокуДанных(
			ТаблицаДанных,
			СтрокаИсточника.ИдентификаторСтроки,
			СтрокаИсточника.Идентификатор,
			СтруктураДанныхИсточника(СтрокаИсточника, СвойстваИсточника),
			ПараметрыСопоставления);
		
		Если Не СтрокаДанных.Отказ Тогда
			
			НезаполненныеПоля = ПроверитьЗаполнениеСтрокиДанных(СтрокаДанных, ПараметрыСопоставления);
			Если НезаполненныеПоля.Количество() <> 0 Тогда
				
				ДобавитьОписаниеОшибки(ПараметрыСопоставления.ОписаниеОшибок,
					СтрШаблон(НСтр("ru = 'Не определено значение для обязательных полей %1'"),
						СтрСоединить(НезаполненныеПоля, ", ")),
					СтрокаИсточника.ИдентификаторСтроки,
					СтрокаДанных.Отказ);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

#КонецОбласти

