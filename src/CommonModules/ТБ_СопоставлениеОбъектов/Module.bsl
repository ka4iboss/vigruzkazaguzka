//
Функция ДобавитьТаблицуФормы(Элементы, Знач Имя, Знач Заголовок, Знач ПутьКДанным, Знач Родитель = Неопределено, Знач Элемент = Неопределено) Экспорт
	
	Если Элемент = Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить(Имя, Тип("ТаблицаФормы"), Родитель);
