
#Область СлужебныйПрограммныйИнтерфейс

// Устанавливает COM-соединение с внешним источником по настройке подключения.
//
// Параметры:
//  НастройкаПодключения - СправочникСсылка.ТБ_НастройкиПодключенияКИсточникам - настройка подключения к источнику.
//
// Возвращаемое значение:
//  Произвольный - установленное COM-соединение или Неопределено, если подключиться не удалось.
//
Функция COMСоединение(Знач НастройкаПодключения) Экспорт
	
	Возврат ТБ_СопоставлениеОбъектов.COMСоединение(НастройкаПодключения);
	
КонецФункции

// Возвращает представление объекта метаданных по его полному имени.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Строка - представление объекта метаданных или исходное полное имя, если объект не найден.
//
Функция ПредставлениеОбъектаМетаданных(Знач ПолноеИмя) Экспорт
	
	Если ЗначениеЗаполнено(ПолноеИмя) Тогда
		
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если ОбъектМетаданных <> Неопределено Тогда
			Возврат ОбъектМетаданных.Представление();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПолноеИмя;
	
КонецФункции

#КонецОбласти
