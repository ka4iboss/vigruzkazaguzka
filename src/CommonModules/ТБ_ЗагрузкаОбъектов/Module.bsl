
#Область ПрограммныйИнтерфейс

#Область КомандыЗагрузкиОбъектов

// Возвращает признак доступности загрузки объектов (право просмотра настроек загрузки).
//
// Возвращаемое значение:
//  Булево - Истина, если загрузка объектов разрешена.
//
Функция РазрешенаЗагрузкаОбъектов() Экспорт
	
	Возврат ПравоДоступа("Просмотр", Метаданные.Справочники.ТБ_НастройкиЗагрузкиОбъектов);
	
КонецФункции

// Заполняет признак "Загружен" в строках динамического списка.
//
// Параметры:
//  Строки - ДанныеФормыКоллекция - строки динамического списка.
//
Процедура ЗаполнитьПризнакЗагружен(Строки) Экспорт
	
	Если Не РазрешенаЗагрузкаОбъектов() Тогда
		Возврат;
	КонецЕсли;
	
	Ключи = Строки.ПолучитьКлючи();
	
	Если Ключи.Количество() = 0
		Или Не Строки[Ключи[0]].Данные.Свойство("ТБ_Загружен") Тогда
		Возврат;
	КонецЕсли;
	
	Ссылки = Новый Массив;
	
	Для каждого Ключ Из Ключи Цикл
		Ссылки.Добавить(Ключ.Ссылка);
	КонецЦикла;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СоответствияОбъектов.Объект КАК Ссылка
	|ИЗ
	|	РегистрСведений.ТБ_СоответствияОбъектов КАК СоответствияОбъектов
	|ГДЕ
	|	СоответствияОбъектов.Объект В(&Ссылки)");
	
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Для каждого Строка Из Строки Цикл
		
		ДанныеСтроки = Строки[Строка.Ключ].Данные;
		
		Выборка.Сбросить();
		
		Если Выборка.НайтиСледующий(ДанныеСтроки.Ссылка, "Ссылка") Тогда
			ДанныеСтроки.ТБ_Загружен = 0;
		Иначе
			ДанныеСтроки.ТБ_Загружен = -1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаОбъектов

// Возвращает параметры загрузки объектов по настройке загрузки.
//
// Параметры:
//  НастройкаЗагрузки - СправочникСсылка.ТБ_НастройкиЗагрузкиОбъектов - настройка загрузки.
//
// Возвращаемое значение:
//  Структура - параметры загрузки:
//   * ИмяОбъекта - Строка - имя объекта.
//   * ИсточникДанных - Строка - источник данных.
//   * ПравилоСопоставления - Строка - правило сопоставления.
//   * ТабличныеЧасти - ТаблицаЗначений - табличные части.
//
Функция ПараметрыЗагрузки(Знач НастройкаЗагрузки) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяОбъекта",           "");
	Результат.Вставить("ИсточникДанных",       "");
	Результат.Вставить("ПравилоСопоставления", "");
	Результат.Вставить("ТабличныеЧасти",       Новый ТаблицаЗначений);
	
	МенеджерОбъекта = Справочники[НастройкаЗагрузки.Метаданные().Имя];
	МенеджерОбъекта.ПолучитьПараметрыЗагрузки(Результат, НастройкаЗагрузки);
	
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу найденных ссылок по параметрам поиска (делегат в модуль сопоставления объектов).
//
// Параметры:
//  ПараметрыПоиска - Структура - значения полей поиска.
//  ПараметрыОбъекта - Структура - параметры сопоставляемого объекта.
//
// Возвращаемое значение:
//  ТаблицаЗначений - найденные ссылки.
//
Функция ТаблицаСсылокПоПараметрам(Знач ПараметрыПоиска, Знач ПараметрыОбъекта) Экспорт
	
	Возврат ТБ_СопоставлениеОбъектов.ТаблицаСсылок(ПараметрыПоиска, ПараметрыОбъекта);
	
КонецФункции

// Находит значение дополнительного реквизита по наименованию в пределах владельца
// (делегат запроса для модуля сопоставления объектов).
//
// Параметры:
//  Наименование - Строка - наименование значения свойства.
//  Владелец - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - владелец значения свойства.
//
// Возвращаемое значение:
//  СправочникСсылка.ЗначенияСвойствОбъектов - найденное значение свойства или пустая ссылка.
//
Функция НайтиЗначениеСвойстваПоНаименованию(Наименование, Владелец) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЗначенияСвойствОбъектов
		|ГДЕ
		|	Наименование = &Наименование
		|	И Владелец = &Владелец";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	
	Результат = Справочники.ЗначенияСвойствОбъектов.ПустаяСсылка();
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выполняет сценарий загрузки объектов по этапам.
//
// Параметры:
//  Сценарий - СправочникСсылка.ТБ_СценарииЗагрузкиОбъектов - сценарий загрузки.
//
// Возвращаемое значение:
//  Булево - Истина, если сценарий выполнен без ошибок.
//
Функция ВыполнитьСценарийЗагрузки(Знач Сценарий) Экспорт
	
	ПараметрыЖурнала = ПараметрыЖурналаЗагрузкаОбъектов(Сценарий);
	
	Если Не ПроверитьСценарийЗагрузки(Сценарий, ПараметрыЖурнала) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РегистрыСведений.ТБ_СостоянияЗагрузкиОбъектов.ЗафиксироватьЗапускСценария(Сценарий);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Этапы.НастройкаЗагрузки КАК НастройкаЗагрузки,
	|	Этапы.ВариантЗагрузки КАК ВариантЗагрузки
	|ИЗ
	|	Справочник.ТБ_СценарииЗагрузкиОбъектов.Этапы КАК Этапы
	|ГДЕ
	|	Этапы.Ссылка = &Сценарий
	|	И Этапы.Пометка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Этапы.НомерСтроки");
	
	Запрос.УстановитьПараметр("Сценарий", Сценарий);
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("СОшибками", Ложь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Результат = ЗагрузитьОбъектыЭтапаСценария(Выборка.НастройкаЗагрузки, Выборка.ВариантЗагрузки);
		
		Если Результат.ОписаниеОшибок.Количество() <> 0 Тогда
			
			РезультатВыполнения.СОшибками = Истина;
			
			Для каждого ОписаниеОшибки Из Результат.ОписаниеОшибок Цикл
				ЗаписьЖурнала(ПараметрыЖурнала, УровеньЖурналаРегистрации.Ошибка, ОписаниеОшибки.ТекстОшибки);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	РегистрыСведений.ТБ_СостоянияЗагрузкиОбъектов.ЗафиксироватьРезультатВыполненияСценария(Сценарий, РезультатВыполнения);
	
	Возврат Не РезультатВыполнения.СОшибками;
	
КонецФункции

// Загружает объекты одного этапа сценария.
//
// Параметры:
//  НастройкаЗагрузки - СправочникСсылка.ТБ_НастройкиЗагрузкиОбъектов - настройка загрузки.
//  ВариантЗагрузки - ПеречислениеСсылка.ТБ_ВариантыЗагрузкиОбъектов - вариант загрузки.
//
// Возвращаемое значение:
//  Произвольный - результат загрузки.
//
Функция ЗагрузитьОбъектыЭтапаСценария(Знач НастройкаЗагрузки, Знач ВариантЗагрузки) Экспорт
	
	ДлительныеОперации.СообщитьПрогресс(0, НСтр("ru = 'Получение списка объектов...'"));
	
	ПараметрыЗагрузки = ПараметрыЗагрузки(НастройкаЗагрузки);
	
	СвойстваИсточника = ТБ_СопоставлениеОбъектов.ТаблицаСвойствИсточникаДанных();
	ТБ_СопоставлениеОбъектов.ЗаполнитьСвойстваИсточникаДанныхПоПравилу(СвойстваИсточника, ПараметрыЗагрузки.ПравилоСопоставления);
	
	ТаблицаСоответствия = ТБ_СопоставлениеОбъектов.ТаблицаСоответствия(СвойстваИсточника);
	ТаблицаСоответствия.Колонки.Добавить("Пометка",           Новый ОписаниеТипов("Булево"));
	ТаблицаСоответствия.Колонки.Добавить("КартинкаСостояние", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	ТаблицаСоответствия.Колонки.Добавить("КартинкаОбъекта",   ОбщегоНазначения.ОписаниеТипаЧисло(1, 0));
	ТаблицаСоответствия.Колонки.Добавить("Проведено",         Новый ОписаниеТипов("Булево"));
	
	ПараметрыЗаполнения = Обработки.ТБ_ЗагрузкаОбъектов.ПараметрыЗаполнения();
	ПараметрыЗаполнения.ИмяОбъекта           = ПараметрыЗагрузки.ИмяОбъекта;
	ПараметрыЗаполнения.ИсточникДанных       = ПараметрыЗагрузки.ИсточникДанных;
	ПараметрыЗаполнения.ПравилоСопоставления = ПараметрыЗагрузки.ПравилоСопоставления;
	ПараметрыЗаполнения.СвойстваИсточника    = СвойстваИсточника;
	ПараметрыЗаполнения.ТаблицаСоответствия  = ТаблицаСоответствия;
	
	Результат = Обработки.ТБ_ЗагрузкаОбъектов.ЗаполнитьТаблицуСоответствия(ПараметрыЗаполнения);
	
	ТаблицаСоответствия = Результат.ТаблицаСоответствия;
	
	//
	
	ИдентификаторСтроки = 0;
	
	Для каждого СтрокаСоответствия Из ТаблицаСоответствия Цикл
		
		Если ВариантЗагрузки = Перечисления.ТБ_ВариантыЗагрузкиОбъектов.Все Тогда
			
			СтрокаСоответствия.Пометка = Истина;
			
		ИначеЕсли ВариантЗагрузки = Перечисления.ТБ_ВариантыЗагрузкиОбъектов.НеЗагруженные Тогда
			
			Если Не ЗначениеЗаполнено(СтрокаСоответствия.Объект) Тогда
				СтрокаСоответствия.Пометка = Истина;
			КонецЕсли;
			
		//ИначеЕсли ВариантЗагрузки = Перечисления.ТБ_ВариантыЗагрузкиОбъектов.Измененные Тогда
		//	
		//	Если ЗначениеЗаполнено(СтрокаСоответствия.Объект)
		//		И Не ПроверитьЗагруженныйОбъект(НастройкаЗагрузки, СтрокаСоответствия.Объект) Тогда
		//		
		//		СтрокаСоответствия.Пометка = Истина;
		//		
		//	КонецЕсли;
		//	
		КонецЕсли;
		
		СтрокаСоответствия.ИдентификаторСтроки = ИдентификаторСтроки;
		
		ИдентификаторСтроки = ИдентификаторСтроки + 1;
		
	КонецЦикла;
	
	//
	
	ПараметрыЗагрузки_ = Новый Структура;
	ПараметрыЗагрузки_.Вставить("ИсточникДанных",      ПараметрыЗагрузки.ИсточникДанных);
	ПараметрыЗагрузки_.Вставить("НастройкаЗагрузки",   НастройкаЗагрузки);
	ПараметрыЗагрузки_.Вставить("СвойстваИсточника",   СвойстваИсточника);
	ПараметрыЗагрузки_.Вставить("ТаблицаСоответствия", ТаблицаСоответствия.Скопировать(Новый Структура("Пометка", Истина)));
	ПараметрыЗагрузки_.Вставить("ВыводитьСообщения",   Ложь);
	
	Результат = Обработки.ТБ_ЗагрузкаОбъектов.ЗагрузитьОбъекты(ПараметрыЗагрузки_);
	
	Для каждого ОписаниеОшибки Из Результат.ОписаниеОшибок Цикл
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки.ТекстОшибки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает параметры журнала регистрации для сценария загрузки.
//
// Параметры:
//  Сценарий - СправочникСсылка.ТБ_СценарииЗагрузкиОбъектов - сценарий загрузки.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - параметры журнала регистрации или Неопределено.
//
Функция ПараметрыЖурналаРегистрации(Знач Сценарий) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Состояния.ПоследнийЗапускНачало КАК ПоследнийЗапускНачало,
	|	Состояния.ПоследнийЗапускЗавершение КАК ПоследнийЗапускЗавершение,
	|	Состояния.НомерСеанса КАК НомерСеанса
	|ИЗ
	|	РегистрСведений.ТБ_СостоянияЗагрузкиОбъектов КАК Состояния
	|ГДЕ
	|	Состояния.Сценарий = &Сценарий");
	
	Запрос.УстановитьПараметр("Сценарий", Сценарий);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДатаНачала",    Выборка.ПоследнийЗапускНачало);
	Результат.Вставить("ДатаОкончания", Выборка.ПоследнийЗапускЗавершение);
	
	// Ограничение интервала не более 30 минут, т.к. номера сеансов могут переиспользоваться.
	Если Не ЗначениеЗаполнено(Результат.ДатаОкончания) Или Результат.ДатаОкончания < Результат.ДатаНачала Тогда
		Результат.ДатаОкончания = Результат.ДатаНачала + 30 * 60;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.НомерСеанса) Тогда
		
		Сеансы = Новый СписокЗначений;
		Сеансы.Добавить(Выборка.НомерСеанса);
		
		Результат.Вставить("Сеанс", Сеансы);
		
	Иначе
		Результат.Вставить("Данные", Сценарий);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область АнализЗагруженныхОбъектов

// Возвращает структуру данных источника по загруженному объекту.
//
// Параметры:
//  Объект - СправочникСсылка, ДокументСсылка - загруженный объект.
//
// Возвращаемое значение:
//  Структура - данные источника по объекту.
//
Функция СтруктураДанныхЗагруженногоОбъекта(Знач Объект) Экспорт
	
	Если ЗначениеЗаполнено(Объект) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	СоответствияОбъектов.ИсточникДанных КАК ИсточникДанных,
		|	СоответствияОбъектов.ДанныеИсточника КАК ДанныеИсточника
		|ИЗ
		|	РегистрСведений.ТБ_СоответствияОбъектов КАК СоответствияОбъектов
		|ГДЕ
		|	СоответствияОбъектов.Объект = &Объект");
		
		Запрос.УстановитьПараметр("Объект", Объект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			ИменаСвойствСоЗначениямиДата = Справочники.ТБ_ИсточникиДанных.ИменаСвойствСоЗначениямиДата(Выборка.ИсточникДанных);
			
			Возврат ТБ_СопоставлениеОбъектов.ЗначениеJSON(Выборка.ДанныеИсточника, ИменаСвойствСоЗначениямиДата);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый Структура;
	
КонецФункции

// Возвращает таблицу отклонений загруженных данных объекта от источника.
//
// Параметры:
//  ПравилоСопоставления - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//  Объект - СправочникСсылка, ДокументСсылка - объект.
//  СтруктураДанных - Структура, Неопределено - данные источника.
//  СтрокиЗагруженныхДанных - Массив из Произвольный, Неопределено - заранее прочитанные данные загруженных строк регистра.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица отклонений.
//
Функция ТаблицаОтклонений(Знач ПравилоСопоставления, Знач Объект, Знач СтруктураДанных = Неопределено,
	Знач СтрокиЗагруженныхДанных = Неопределено) Экспорт
	
	Если СтрокиЗагруженныхДанных = Неопределено И ЗначениеЗаполнено(Объект) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЗагруженныеДанныеИсточника.ДанныеИсточника КАК ДанныеИсточника
		|ИЗ
		|	РегистрСведений.ТБ_ЗагруженныеДанныеИсточника КАК ЗагруженныеДанныеИсточника
		|ГДЕ
		|	ЗагруженныеДанныеИсточника.ПравилоСопоставления = &ПравилоСопоставления
		|	И ЗагруженныеДанныеИсточника.Объект = &Объект");
		
		Запрос.УстановитьПараметр("ПравилоСопоставления", ПравилоСопоставления);
		Запрос.УстановитьПараметр("Объект",               Объект);
		
		СтрокиЗагруженныхДанных = Новый Массив;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокиЗагруженныхДанных.Добавить(Выборка.ДанныеИсточника);
		КонецЦикла;
		
	КонецЕсли;
	
	СвойстваИсточника = ТБ_СопоставлениеОбъектов.ТаблицаСвойствИсточникаДанных();
	ТБ_СопоставлениеОбъектов.ЗаполнитьСвойстваИсточникаДанныхПоПравилу(СвойстваИсточника, ПравилоСопоставления);
	
	ИменаСвойствСоЗначениямиДата = СвойстваИсточника.Скопировать(Новый Структура("Тип", "Дата"), "Имя").ВыгрузитьКолонку("Имя");
	ИменаПолей                   = СвойстваИсточника.ВыгрузитьКолонку("Имя");
	
	//
	
	Если СтруктураДанных = Неопределено Тогда
		СтруктураДанных = СтруктураДанныхЗагруженногоОбъекта(Объект);
	КонецЕсли;
	
	//
	
	ТаблицаОтклонений = ТБ_СопоставлениеОбъектов.ТаблицаИсточника(СвойстваИсточника);
	ИсточникДанных    = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоСопоставления, "ИсточникДанных");
	
	ПараметрыОтбора = ТБ_СопоставлениеОбъектов.ПараметрыОтбораИдентификатора(ПравилоСопоставления, СтруктураДанных);
	
	ТБ_СопоставлениеОбъектов.ЗагрузитьИзВнешнегоИсточника(ТаблицаОтклонений, ИсточникДанных, СвойстваИсточника, ПараметрыОтбора, Ложь);
	
	ТаблицаОтклонений = ТБ_СопоставлениеОбъектов.ТаблицаИсточникаСОтборами(ТаблицаОтклонений, СвойстваИсточника, ПравилоСопоставления);
	ТаблицаОтклонений.Колонки.Добавить("Отклонение", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	ТаблицаОтклонений.ЗаполнитьЗначения(1, "Отклонение");
	
	//
	
	Если СтрокиЗагруженныхДанных <> Неопределено Тогда
		
		Для каждого ДанныеИсточника Из СтрокиЗагруженныхДанных Цикл
			
			СтруктураДанных_ = ТБ_СопоставлениеОбъектов.ЗначениеJSON(ДанныеИсточника, ИменаСвойствСоЗначениямиДата);
			
			НоваяСтрока = ТаблицаОтклонений.Добавить();
			НоваяСтрока.Отклонение = -1;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДанных_);
			
		КонецЦикла;
		
	КонецЕсли;
	
	//
	
	ТаблицаОтклонений.Свернуть(СтрСоединить(ИменаПолей, ","), "Отклонение");
	
	//
	
	Результат = ТаблицаОтклонений.СкопироватьКолонки();
	
	Для каждого СтрокаТаблицы Из ТаблицаОтклонений Цикл
		
		Если СтрокаТаблицы.Отклонение <> 0 Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаТаблицы);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет актуальность загруженного объекта по таблицам отклонений.
//
// Параметры:
//  НастройкаЗагрузки - СправочникСсылка.ТБ_НастройкиЗагрузкиОбъектов - настройка загрузки.
//  Объект - СправочникСсылка, ДокументСсылка - объект.
//
// Возвращаемое значение:
//  Булево - Истина, если отклонений нет.
//
Функция ПроверитьЗагруженныйОбъект(Знач НастройкаЗагрузки, Знач Объект) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТабличныеЧасти.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ТабличныеЧасти.ПравилоСопоставления КАК ПравилоСопоставления
	|ИЗ
	|	Справочник.ТБ_НастройкиЗагрузкиОбъектов.ТабличныеЧасти КАК ТабличныеЧасти
	|ГДЕ
	|	ТабличныеЧасти.Ссылка = &НастройкаЗагрузки");
	
	Запрос.УстановитьПараметр("НастройкаЗагрузки", НастройкаЗагрузки);
	
	Правила = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Правила.Добавить(Выборка.ПравилоСопоставления);
	КонецЦикла;
	
	СтрокиПоПравилам = Новый Соответствие;
	
	Для каждого ПравилоСопоставления Из Правила Цикл
		СтрокиПоПравилам.Вставить(ПравилоСопоставления, Новый Массив);
	КонецЦикла;
	
	Если Правила.Количество() > 0 И ЗначениеЗаполнено(Объект) Тогда
		
		ЗапросДанных = Новый Запрос(
		"ВЫБРАТЬ
		|	ЗагруженныеДанныеИсточника.ПравилоСопоставления КАК ПравилоСопоставления,
		|	ЗагруженныеДанныеИсточника.ДанныеИсточника КАК ДанныеИсточника
		|ИЗ
		|	РегистрСведений.ТБ_ЗагруженныеДанныеИсточника КАК ЗагруженныеДанныеИсточника
		|ГДЕ
		|	ЗагруженныеДанныеИсточника.ПравилоСопоставления В (&Правила)
		|	И ЗагруженныеДанныеИсточника.Объект = &Объект");
		
		ЗапросДанных.УстановитьПараметр("Правила", Правила);
		ЗапросДанных.УстановитьПараметр("Объект",  Объект);
		
		ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
		Пока ВыборкаДанных.Следующий() Цикл
			
			СтрокиПравила = СтрокиПоПравилам.Получить(ВыборкаДанных.ПравилоСопоставления);
			Если СтрокиПравила = Неопределено Тогда
				СтрокиПравила = Новый Массив;
				СтрокиПоПравилам.Вставить(ВыборкаДанных.ПравилоСопоставления, СтрокиПравила);
			КонецЕсли;
			
			СтрокиПравила.Добавить(ВыборкаДанных.ДанныеИсточника);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого ПравилоСопоставления Из Правила Цикл
		
		ТаблицаОтклонений = ТБ_СопоставлениеОбъектов.ТаблицаОтклоненийОбъекта(
			ПравилоСопоставления,
			Объект,
			,
			СтрокиПоПравилам.Получить(ПравилоСопоставления));
		
		Если ТаблицаОтклонений.Количество() <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗагрузкаОбъектов

Функция ПроверитьСценарийЗагрузки(Знач Сценарий, Знач ПараметрыЖурнала)
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сценарий, "Статус,ПометкаУдаления");
	
	Строки = Новый Массив;
	
	Если ЗначенияРеквизитов.Статус <> Перечисления.ТБ_СтатусыСценариевЗагрузки.Действует Тогда
		Строки.Добавить(НСтр("ru = 'Сценарий не действует'"));
	КонецЕсли;
	
	Если ЗначенияРеквизитов.ПометкаУдаления Тогда
		Строки.Добавить(НСтр("ru = 'Сценарий помечен на удаление'"));
	КонецЕсли;
	
	Если Строки.Количество() <> 0 Тогда
		
		ЗаписьЖурнала(ПараметрыЖурнала, УровеньЖурналаРегистрации.Предупреждение, НСтр("ru = 'Завершение'"), СтрСоединить(Строки, Символы.ПС));
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ЖурналРегистрации

Функция ПараметрыЖурналаЗагрузкаОбъектов(Знач Сценарий = Неопределено)
	
	ПараметрыЖурнала = Новый Структура;
	ПараметрыЖурнала.Вставить("ИмяСобытия", НСтр("ru = 'Загрузка объектов. Запуск по требованию'", ОбщегоНазначения.КодОсновногоЯзыка()));
	ПараметрыЖурнала.Вставить("Данные",     Сценарий);
	ПараметрыЖурнала.Вставить("Метаданные", ?(Сценарий <> Неопределено, Сценарий.Метаданные(), Неопределено));
	
	Возврат ПараметрыЖурнала;
	
КонецФункции

Процедура ЗаписьЖурнала(ПараметрыЖурнала, Знач УровеньЖурнала = Неопределено, Знач Текст = "", Знач ОписаниеПроблемы = Неопределено)
	
	Если ПараметрыЖурнала = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Определение уровня журнала регистрации на основе типа переданного сообщения об ошибке.
	Если ТипЗнч(УровеньЖурнала) <> Тип("УровеньЖурналаРегистрации") Тогда
		
		Если ТипЗнч(ОписаниеПроблемы) = Тип("ИнформацияОбОшибке") Тогда
			УровеньЖурнала = УровеньЖурналаРегистрации.Ошибка;
		ИначеЕсли ТипЗнч(ОписаниеПроблемы) = Тип("Строка") Тогда
			УровеньЖурнала = УровеньЖурналаРегистрации.Предупреждение;
		Иначе
			УровеньЖурнала = УровеньЖурналаРегистрации.Информация;
		КонецЕсли;
		
	КонецЕсли;
	
	Если УровеньЖурнала = УровеньЖурналаРегистрации.Ошибка Тогда
		ПараметрыЖурнала.Вставить("БылиОшибки", Истина);
	ИначеЕсли УровеньЖурнала = УровеньЖурналаРегистрации.Предупреждение Тогда
		ПараметрыЖурнала.Вставить("БылиПредупреждения", Истина);
	КонецЕсли;
	
	ЗаписатьВЖурнал = ЗначениеЗаполнено(ПараметрыЖурнала.Данные);
	
	ТекстДляЖурнала      = Текст;
	ТекстДляПользователя = Текст;
	
	Если ТипЗнч(ОписаниеПроблемы) = Тип("ИнформацияОбОшибке") Тогда
		
		Если ЗаписатьВЖурнал Тогда
			ТекстДляЖурнала = ТекстДляЖурнала + Символы.ПС + ПодробноеПредставлениеОшибки(ОписаниеПроблемы);
		КонецЕсли;
		
		ТекстДляПользователя = ТекстДляПользователя + Символы.ПС + КраткоеПредставлениеОшибки(ОписаниеПроблемы);
		
	ИначеЕсли ТипЗнч(ОписаниеПроблемы) = Тип("Строка") Тогда
		
		Если ЗаписатьВЖурнал Тогда
			ТекстДляЖурнала = ТекстДляЖурнала + Символы.ПС + ОписаниеПроблемы;
		КонецЕсли;
		
		ТекстДляПользователя = ТекстДляПользователя + Символы.ПС + ОписаниеПроблемы;
		
	КонецЕсли;
	
	// Журнал регистрации.
	Если ЗаписатьВЖурнал Тогда
		
		ЗаписьЖурналаРегистрации(ПараметрыЖурнала.ИмяСобытия, УровеньЖурнала, ПараметрыЖурнала.Метаданные, 
			ПараметрыЖурнала.Данные, СокрЛП(ТекстДляЖурнала));
		
	КонецЕсли;
	
	// Сообщение пользователю.
	ТекстДляПользователя = СокрЛП(ТекстДляПользователя);
	
	Если (УровеньЖурнала = УровеньЖурналаРегистрации.Ошибка) Или (УровеньЖурнала = УровеньЖурналаРегистрации.Предупреждение) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстДляПользователя;
		Сообщение.УстановитьДанные(ПараметрыЖурнала.Данные);
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбменСЗагрузкойОбъектов

// Загружает данные табличной части объекта из источника по правилу сопоставления.
//
// Параметры:
//  ДанныеОбъекта - Структура - данные объекта.
//  ПравилоСопоставления - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//  ПараметрыОтбора - Структура - параметры отбора идентификатора.
//  ОписаниеОшибок - Массив из Произвольный - описание ошибок.
//  Соединение - COMОбъект, Неопределено - соединение с внешним источником.
//  СвойстваИсточникаПредзагруженные - ТаблицаЗначений, Неопределено - заранее загруженные свойства источника.
//
Процедура ЗагрузитьДанныеТабличнойЧастиПоПравилу(ДанныеОбъекта, Знач ПравилоСопоставления, Знач ПараметрыОтбора, ОписаниеОшибок,
	Соединение = Неопределено, Знач СвойстваИсточникаПредзагруженные = Неопределено) Экспорт
	
	ТБ_СопоставлениеОбъектов.ЗагрузитьДанныеТабличнойЧасти(ДанныеОбъекта, ПравилоСопоставления, ПараметрыОтбора, ОписаниеОшибок,
		Соединение, СвойстваИсточникаПредзагруженные);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
