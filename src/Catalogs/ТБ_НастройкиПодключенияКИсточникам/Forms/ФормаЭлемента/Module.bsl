
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьРеквизитыПодключения(ТекущийОбъект.СтрокаПодключения);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.СтрокаПодключения = СтрокаПодключенияИзРеквизитов(ТекущийОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	
	Если Модифицированность Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПроверитьПодключениеЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Перед проверкой подключения необходимо записать настройки. Записать?'");
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	ПроверитьПодключениеНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьПодключениеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		Если Записать() Тогда
			ПроверитьПодключениеНаСервере();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПодключениеНаСервере()
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Соединение = ТБ_СопоставлениеОбъектовПовтИсп.COMСоединение(Объект.Ссылка);
	
	ТекстСообщения = ?(Соединение = Неопределено,
		НСтр("ru = 'При подключении к источнику возникли ошибки (см. Журнал регистрации).'"),
		НСтр("ru = 'Подключение к источнику успешно установлено.'"));
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

// Заполняет реквизиты формы данными из строки подключения.
//
// Параметры:
//  СтрокаПодключения - Строка - строка подключения к источнику данных.
//
&НаСервере
Процедура ЗаполнитьРеквизитыПодключения(Знач СтрокаПодключения)
	
	ПараметрыПодключения = ПараметрыСтрокиПодключения(СтрокаПодключения);
	
	Сервер             = ПараметрСтрокиПодключения(ПараметрыПодключения, "srvr");
	База               = ПараметрСтрокиПодключения(ПараметрыПодключения, "ref");
	ИмяПользователя   = ПараметрСтрокиПодключения(ПараметрыПодключения, "usr");
	ПарольПользователя = ПараметрСтрокиПодключения(ПараметрыПодключения, "pwd");
	
КонецПроцедуры

// Собирает строку подключения из реквизитов формы.
//
// Параметры:
//  ТекущийОбъект - СправочникОбъект.ТБ_НастройкиПодключенияКИсточникам - записываемый объект.
//
// Возвращаемое значение:
//  Строка - строка подключения к источнику данных.
//
&НаСервере
Функция СтрокаПодключенияИзРеквизитов(Знач ТекущийОбъект)
	
	Если ПустаяСтрока(Сервер)
		И ПустаяСтрока(База)
		И ПустаяСтрока(ИмяПользователя)
		И ПустаяСтрока(ПарольПользователя) Тогда
		
		// Реквизиты не заполнены: возможно, строка подключения задана вручную
		// (например, для файловой базы) - не затираем ее.
		Возврат ТекущийОбъект.СтрокаПодключения;
		
	КонецЕсли;
	
	Возврат "Srvr=" + ЗначениеВКавычкахСтрокиПодключения(Сервер)
		+ ";Ref=" + ЗначениеВКавычкахСтрокиПодключения(База)
		+ ";Usr=" + ЗначениеВКавычкахСтрокиПодключения(ИмяПользователя)
		+ ";Pwd=" + ЗначениеВКавычкахСтрокиПодключения(ПарольПользователя) + ";";
	
КонецФункции

// Разбирает строку подключения на параметры.
//
// Параметры:
//  СтрокаПодключения - Строка - строка подключения к источнику данных.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - параметры строки подключения:
//   * Ключ - Строка - имя параметра в нижнем регистре;
//   * Значение - Строка - значение параметра.
//
&НаСервере
Функция ПараметрыСтрокиПодключения(Знач СтрокаПодключения)
	
	ПараметрыПодключения = Новый Соответствие;
	
	Для Каждого ЧастьСтроки Из СтрРазделить(СтрокаПодключения, ";", Ложь) Цикл
		
		ПозицияРавно = СтрНайти(ЧастьСтроки, "=");
		
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПараметра = НРег(СокрЛП(Лев(ЧастьСтроки, ПозицияРавно - 1)));
		ЗначениеПараметра = СокрЛП(Сред(ЧастьСтроки, ПозицияРавно + 1));
		
		Если СтрДлина(ЗначениеПараметра) >= 2
			И Лев(ЗначениеПараметра, 1) = """"
			И Прав(ЗначениеПараметра, 1) = """" Тогда
			
			ЗначениеПараметра = Сред(ЗначениеПараметра, 2, СтрДлина(ЗначениеПараметра) - 2);
			ЗначениеПараметра = СтрЗаменить(ЗначениеПараметра, """""", """");
			
		КонецЕсли;
		
		Если Не ПустаяСтрока(ИмяПараметра) Тогда
			ПараметрыПодключения.Вставить(ИмяПараметра, ЗначениеПараметра);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПараметрыПодключения;
	
КонецФункции

// Возвращает значение параметра строки подключения.
//
// Параметры:
//  ПараметрыПодключения - Соответствие из КлючИЗначение - параметры строки подключения.
//  ИмяПараметра - Строка - имя параметра в нижнем регистре.
//
// Возвращаемое значение:
//  Строка - значение параметра; пустая строка, если параметр не найден.
//
&НаСервере
Функция ПараметрСтрокиПодключения(Знач ПараметрыПодключения, Знач ИмяПараметра)
	
	ЗначениеПараметра = ПараметрыПодключения.Получить(ИмяПараметра);
	
	Возврат ?(ЗначениеПараметра = Неопределено, "", ЗначениеПараметра);
	
КонецФункции

// Заключает значение параметра строки подключения в кавычки.
//
// Параметры:
//  Значение - Строка - значение параметра строки подключения.
//
// Возвращаемое значение:
//  Строка - значение, заключенное в кавычки.
//
&НаСервере
Функция ЗначениеВКавычкахСтрокиПодключения(Знач Значение)
	
	Возврат """" + СтрЗаменить(Значение, """", """""") + """";
	
КонецФункции

#КонецОбласти
