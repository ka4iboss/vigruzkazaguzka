
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Если Параметры.Свойство("ЗначениеКопирования")
			И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			
			ОбъектКопирования = Параметры.ЗначениеКопирования.ПолучитьОбъект();
			ПолучитьЗначенияРеквизитовИзХранилища(ОбъектКопирования);
			
			НастройкиКомпоновки = ОбъектКопирования.КомпоновщикНастроек.Получить();
			
		Иначе
			НастройкиКомпоновки = Неопределено;
		КонецЕсли;
		
		ПриЧтенииСозданииНаСервере();
		
		ТБ_СопоставлениеОбъектов.ИнициализироватьКомпоновщик(
			КомпоновщикНастроек,
			УникальныйИдентификатор,
			СвойстваИсточникаДанных,
			НастройкиКомпоновки);
		
	КонецЕсли;
	
	// 2024.01.26 Заменили список выбора, справочником, для использования иерархии
	//ТБ_СопоставлениеОбъектов.ЗаполнитьСписокВыбораОбъекта(Элементы.ИмяОбъекта.СписокВыбора); 
	
	Если ЗначениеЗаполнено(Объект.ИмяОбъекта) Тогда
		ТБ_СопоставлениеОбъектов.ЗаполнитьСписокВыбораИмяОбъекта(Объект.ИмяОбъекта, Элементы.ИмяОбъекта.СписокВыбора);
	КонецЕсли;
	
	ПроверитьИзменитьПризнакГруппы(ЭтотОбъект, Объект.ИмяОбъекта);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПолучитьЗначенияРеквизитовИзХранилища(ТекущийОбъект);
	
	ПриЧтенииСозданииНаСервере();
	
	УстановитьПоказатьТолькоВыбранныеРеквизиты(ЭтотОбъект, Истина);
	УстановитьПоказатьТолькоВыбранныеДопРеквизиты(ЭтотОбъект, Истина);
	
	НастройкиКомпоновки = ТекущийОбъект.КомпоновщикНастроек.Получить();
	
	ТБ_СопоставлениеОбъектов.ИнициализироватьКомпоновщик(
		КомпоновщикНастроек,
		УникальныйИдентификатор,
		СвойстваИсточникаДанных,
		НастройкиКомпоновки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.ДополнительныеРеквизиты.Количество() = 0 Тогда
		Элементы.ГруппаДопРеквизиты.Скрыть();
	КонецЕсли; 
	
КонецПроцедуры 

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Для каждого ТекущаяСтрока Из Объект.Реквизиты Цикл
		
		СтрокаТЧ = ТекущийОбъект.Реквизиты[ТекущаяСтрока.НомерСтроки - 1];
		СтрокаТЧ.ТипЗначенияХранилище = Новый ХранилищеЗначения(ТекущаяСтрока.ТипЗначения);
		СтрокаТЧ.ЗначениеХранилище    = Новый ХранилищеЗначения(ТекущаяСтрока.Значение);
		
	КонецЦикла;
	
	Для каждого ТекущаяСтрока Из Объект.ДополнительныеРеквизиты Цикл
		
		СтрокаТЧ = ТекущийОбъект.ДополнительныеРеквизиты[ТекущаяСтрока.НомерСтроки - 1];
		СтрокаТЧ.ТипЗначенияХранилище = Новый ХранилищеЗначения(ТекущаяСтрока.ТипЗначения);
		СтрокаТЧ.ЗначениеХранилище    = Новый ХранилищеЗначения(ТекущаяСтрока.Значение);
		
	КонецЦикла;
	
	ТекущийОбъект.КомпоновщикНастроек = Новый ХранилищеЗначения(КомпоновщикНастроек.ПолучитьНастройки());
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПолучитьЗначенияРеквизитовИзХранилища(ТекущийОбъект);
	
	ЗаполнитьСлужебныеРеквизиты("Реквизиты");
	ЗаполнитьСлужебныеРеквизиты("ДополнительныеРеквизиты");
	
	Элементы.СтраницаОбработчикПередСопоставлением.Картинка   = ОбщегоНазначенияКлиентСервер.КартинкаКомментария(Объект.ОбработчикПередСопоставлением);
	Элементы.СтраницаОбработчикПередОбработкой.Картинка       = ОбщегоНазначенияКлиентСервер.КартинкаКомментария(Объект.ОбработчикПередОбработкой);
	Элементы.СтраницаОбработчикПослеЗаполненияСтроки.Картинка = ОбщегоНазначенияКлиентСервер.КартинкаКомментария(Объект.ОбработчикПослеЗаполненияСтрокиТаблицы);
	Элементы.СтраницаОбработчикПередЗаписью.Картинка          = ОбщегоНазначенияКлиентСервер.КартинкаКомментария(Объект.ОбработчикПередЗаписью);
	Элементы.СтраницаОбработчикПослеЗаписи.Картинка           = ОбщегоНазначенияКлиентСервер.КартинкаКомментария(Объект.ОбработчикПослеЗаписи);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИсточникДанныхПриИзменении(Элемент)
	
	ИсточникДанныхПриИзмененииНаСервере();
	
	ЗаполнитьСписокВыбораНаименования(ЭтотОбъект, Элементы.Наименование.СписокВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяОбъектаПриИзменении(Элемент)
	
	Объект.ПредставлениеОбъекта        = ТБ_СопоставлениеОбъектовКлиент.ПредставлениеЗначения(Объект.ИмяОбъекта, Элементы.ИмяОбъекта.СписокВыбора);
	Объект.ИмяТабличнойЧасти           = "";
	Объект.ПредставлениеТабличнойЧасти = "";
	Объект.ВидНоменклатуры             = Неопределено;
	
	ИмяОбъектаПриИзмененииНаСервере();
	
	ЗаполнитьСписокВыбораНаименования(ЭтотОбъект, Элементы.Наименование.СписокВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяТабличнойЧастиПриИзменении(Элемент)
	
	Объект.ПредставлениеТабличнойЧасти = ТБ_СопоставлениеОбъектовКлиент.ПредставлениеЗначения(Объект.ИмяТабличнойЧасти, Элементы.ИмяТабличнойЧасти.СписокВыбора);
	Объект.ВидНоменклатуры             = Неопределено;
	
	ИмяТабличнойЧастиПриИзмененииНаСервере();
	
	ЗаполнитьСписокВыбораНаименования(ЭтотОбъект, Элементы.Наименование.СписокВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПриИзменении(Элемент)
	
	ЗаполнитьТаблицуДопРеквизитов();
	
	ЗаполнитьСписокВыбораНаименования(ЭтотОбъект, Элементы.Наименование.СписокВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяОбъектаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ОткрытьФорму("Справочник.ТБ_Объекты.ФормаВыбора",, Элементы.ИмяОбъекта,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ИмяОбъектаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Строка") Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	СтруктураВыбранногоЗначения = ИмяОбъектаОбработкаВыбораНаСервере(ВыбранноеЗначение);   
	
	ИмяОбъектаСписокВыбора = Элементы.ИмяОбъекта.СписокВыбора;
	
	ИмяОбъектаСписокВыбора.Очистить();
	
	ИмяОбъектаСписокВыбора.Добавить(СтруктураВыбранногоЗначения.ПолноеИмя, СтруктураВыбранногоЗначения.Наименование);
	
	ВыбранноеЗначение = СтруктураВыбранногоЗначения.ПолноеИмя;
	
	ПроверитьИзменитьПризнакГруппы(ЭтотОбъект, СтруктураВыбранногоЗначения.ПолноеИмя);

КонецПроцедуры

&НаКлиенте
Процедура ИмяОбъектаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКомпоновщикНастроекНастройкиОтбор

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборПриИзменении(Элемент)
	
	ОбновитьОбязательныеСвойстваИсточника();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРеквизиты

&НаКлиенте
Процедура РеквизитыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.РеквизитыИндексКартинкиТип Тогда
		
		СтандартнаяОбработка = Ложь;
		ВыборТипаЗначения(Элемент, "Реквизиты");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПриАктивизацииЯчейки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент = Элементы.РеквизитыЗначение Тогда
		Элементы.РеквизитыЗначение.ОграничениеТипа = ТекущиеДанные.ТипЗначения;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПометкаПриИзменении(Элемент)
	
	СортироватьТаблицуРеквизитов("Реквизиты", Элементы.Реквизиты.ТекущаяСтрока);
	
	ОбновитьОтборСтрокТаблицыРеквизитов(ЭтотОбъект);
	ОбновитьОбязательныеСвойстваИсточника();
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПоискПриИзменении(Элемент)
	
	УстановитьПометкуВТаблицеРеквизитов("Реквизиты");
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыВариантЗаполненияПриИзменении(Элемент)
	
	УстановитьПометкуВТаблицеРеквизитов("Реквизиты");
	ОбновитьОбязательныеСвойстваИсточника();
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыЗначениеПриИзменении(Элемент)
	
	ЗначениеПриИзмененииНаСервере("Реквизиты", Элементы.Реквизиты.ТекущаяСтрока);
	
	УстановитьПометкуВТаблицеРеквизитов("Реквизиты");
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыСвойствоИсточникаПриИзменении(Элемент)
	
	УстановитьПометкуВТаблицеРеквизитов("Реквизиты");
	ОбновитьОбязательныеСвойстваИсточника();
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыСвойствоИсточникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Реквизиты.ТекущиеДанные;
	
	//Если ТекущиеДанные.ВариантЗаполнения = ПредопределенноеЗначение("Перечисление.ТБ_ВариантыЗаполнения.ЗначениеИсточника") Тогда
	Если ТекущиеДанные.ВариантЗаполнения = ПредопределенноеЗначение("Перечисление.ТБ_ВариантыЗаполнения.ЗначениеИсточника") 
		И Не ТекущиеДанные.Имя = "Ссылка" Тогда
		ДанныеВыбора = ДанныеВыбораСвойстваИсточника(Строка(ТекущиеДанные.ТипЗначения));
	Иначе
		ДанныеВыбора = ДанныеВыбораСвойстваИсточника("Строка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыОбработчикПриИзменении(Элемент)
	
	УстановитьПометкуВТаблицеРеквизитов("Реквизиты");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДополнительныеРеквизиты

&НаКлиенте
Процедура ДополнительныеРеквизитыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.ДополнительныеРеквизитыИндексКартинкиТип Тогда
		
		СтандартнаяОбработка = Ложь;
		ВыборТипаЗначения(Элемент, "ДополнительныеРеквизиты");
		
	ИначеЕсли Поле = Элементы.ДополнительныеРеквизитыРеквизит Тогда
		
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, Элемент.ТекущиеДанные.Свойство);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеРеквизитыПриАктивизацииЯчейки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент = Элементы.ДополнительныеРеквизитыЗначение Тогда
		
		Элементы.ДополнительныеРеквизитыЗначение.ОграничениеТипа = ТекущиеДанные.ТипЗначения;
		
		Если ТекущиеДанные.ТипЗначения.Типы().Найти(Тип("СправочникСсылка.ЗначенияСвойствОбъектов")) <> Неопределено Тогда
			
			ПараметрВыбора = Новый ПараметрВыбора("Отбор.Владелец", ТекущиеДанные.Свойство);
			Массив = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрВыбора);
			
		Иначе
			Массив = Новый Массив;
		КонецЕсли;
		
		Элементы.ДополнительныеРеквизитыЗначение.ПараметрыВыбора = Новый ФиксированныйМассив(Массив);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеРеквизитыПометкаПриИзменении(Элемент)
	
	СортироватьТаблицуРеквизитов("ДополнительныеРеквизиты", Элементы.ДополнительныеРеквизиты.ТекущаяСтрока);
	
	ОбновитьОтборСтрокТаблицыДопРеквизитов(ЭтотОбъект);
	ОбновитьОбязательныеСвойстваИсточника();
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеРеквизитыПоискПриИзменении(Элемент)
	
	УстановитьПометкуВТаблицеРеквизитов("ДополнительныеРеквизиты");
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеРеквизитыВариантЗаполненияПриИзменении(Элемент)
	
	УстановитьПометкуВТаблицеРеквизитов("ДополнительныеРеквизиты");
	ОбновитьОбязательныеСвойстваИсточника();
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеРеквизитыЗначениеПриИзменении(Элемент)
	
	ЗначениеПриИзмененииНаСервере("ДополнительныеРеквизиты", Элементы.ДополнительныеРеквизиты.ТекущаяСтрока);
	
	УстановитьПометкуВТаблицеРеквизитов("ДополнительныеРеквизиты");
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеРеквизитыСвойствоИсточникаПриИзменении(Элемент)
	
	УстановитьПометкуВТаблицеРеквизитов("ДополнительныеРеквизиты");
	ОбновитьОбязательныеСвойстваИсточника();
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеРеквизитыСвойствоИсточникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ДополнительныеРеквизиты.ТекущиеДанные;
	
	Если ТекущиеДанные.ВариантЗаполнения = ПредопределенноеЗначение("Перечисление.ТБ_ВариантыЗаполнения.ЗначениеИсточника") Тогда
		ДанныеВыбора = ДанныеВыбораСвойстваИсточника(Строка(ТекущиеДанные.ТипЗначения));
	Иначе
		ДанныеВыбора = ДанныеВыбораСвойстваИсточника("Строка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеРеквизитыОбработчикПриИзменении(Элемент)
	
	УстановитьПометкуВТаблицеРеквизитов("ДополнительныеРеквизиты");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСвойстваИсточника

&НаКлиенте
Процедура СвойстваИсточникаПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СвойстваИсточника.ТекущиеДанные;
	Если Не ТекущиеДанные.Пометка Тогда
		
		ТекущиеДанные.ВключатьВИдентификатор = Ложь;
		ТекущиеДанные.ВключатьВПредставление = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвойстваИсточникаВключатьВИдентификаторПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СвойстваИсточника.ТекущиеДанные;
	Если Не ТекущиеДанные.Пометка Тогда
		ТекущиеДанные.Пометка = Истина;
	КонецЕсли;
	
