// Возвращает свойства, входящие в идентификатор правила сопоставления.
//
// Параметры:
//  ПравилоСопоставления - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//
// Возвращаемое значение:
//  ТаблицаЗначений - свойства идентификатора (Имя, Тип, ТипСсылки).
//
Функция СвойстваИдентификатора(Знач ПравилоСопоставления) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Свойства.Имя КАК Имя,
	|	Свойства.Тип КАК Тип,
	|	Свойства.ТипСсылки КАК ТипСсылки
	|ИЗ
	|	Справочник.ТБ_ПравилаСопоставления.СвойстваИсточника КАК СвойстваИсточника
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТБ_ИсточникиДанных.Свойства КАК Свойства
	|		ПО СвойстваИсточника.Ссылка.ИсточникДанных = Свойства.Ссылка
	|			И СвойстваИсточника.Имя = Свойства.Имя
	|ГДЕ
	|	СвойстваИсточника.Ссылка = &ПравилоСопоставления
	|	И СвойстваИсточника.ВключатьВИдентификатор
	|
	|УПОРЯДОЧИТЬ ПО
	|	СвойстваИсточника.НомерСтроки");
	
	Запрос.УстановитьПараметр("ПравилоСопоставления", ПравилоСопоставления);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Заполняет структуру параметрами загрузки по правилу сопоставления.
//
// Параметры:
//  Параметры - Структура - структура, в которую записываются параметры.
//  ПравилоСопоставления - СправочникСсылка.ТБ_ПравилаСопоставления - правило сопоставления.
//
Процедура ПолучитьПараметрыЗагрузки(Параметры, Знач ПравилоСопоставления) Экспорт
	
	Если Не ЗначениеЗаполнено(ПравилоСопоставления) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПравилаСопоставления.ИмяОбъекта КАК ИмяОбъекта,
	|	ПравилаСопоставления.ИсточникДанных КАК ИсточникДанных,
	|	ПравилаСопоставления.Ссылка КАК ПравилоСопоставления
	|ИЗ
	|	Справочник.ТБ_ПравилаСопоставления КАК ПравилаСопоставления
	|ГДЕ
	|	ПравилаСопоставления.Ссылка = &ПравилоСопоставления");
	
	Запрос.УстановитьПараметр("ПравилоСопоставления", ПравилоСопоставления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(Параметры, Выборка);
	
КонецПроцедуры

#КонецОбласти

